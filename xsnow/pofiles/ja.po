msgid "%s. Snow window: %#lx"
msgstr "%s。雪のウィンドウ: %#lx"

#, c-format
msgid "More than %d errors, I quit!"
msgstr "%d 個を超えるエラーが発生したため、終了しました。"

#, c-format
msgid "Window size changed, now snowing in in %#lx: %s %d+%d %dx%d\n"
msgstr "ウィンドウ サイズが変更され、%#lx に雪が降っています: %s %d+%d %dx%d\n"

#, c-format
msgid "Halting because of flag %s\n"
msgstr "フラグ %s のため停止しています\n"

#, c-format
