msgid "Try redirecting to a file (e.g: %s,\n"
msgstr "Próbáljon átirányítani egy fájlra (pl.: %s,\n"

#, c-format
msgid "or use a %s"
msgstr "vagy használjon egy %s-t"

msgid "Problems encountered during production of the tar ball.\n"
msgstr "A kátránygolyó gyártása során felmerült problémák. \n"

#, c-format
msgid "Self replication is not compiled in.\n"
msgstr "Az önreplikáció nincs itt fordítva. \n"

