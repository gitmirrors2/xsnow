msgstr "Wayland (némi lomhaságra számíthat)"

msgid "Probably X11"
msgstr "Valószínűleg X11"

#, c-format
msgid "%s. Snow window: %#lx"
msgstr "%s. Hóablak: %#lx"

#, c-format
msgid "More than %d errors, I quit!"
msgstr "Több mint %d hiba, kilépek!"

#, c-format
msgid "Window size changed, now snowing in in %#lx: %s %d+%d %dx%d\n"
msgstr "Az ablak mérete megváltozott, most havazik %#lx: %s %d+%d %dx%d\n"

