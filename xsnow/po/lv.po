#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"Sistēma ir pārāk aizņemta. Iesakiet samazināt 'cpu slodzi' sadaļā "
"'iestatījumi\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr ""
" vai apskatiet 'sniegu': 'Intensitāte', 'Maksimālais pārslu skaits', ...\n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " vai norādiet mazāku putnu skaitu laukā 'putni'\n"

