msgstr "Skatiet arī mana lapu."

#, c-format
msgid "Warning: -auroraleft is deprecated, use -aurorax 25 instead.\n"
msgstr ""
"Brīdinājums: -auroraleft ir novecojis, tā vietā izmantojiet -aurorax 25.\n"

#, c-format
msgid "Warning: -auroramiddle is deprecated, use -aurorax 50 instead.\n"
msgstr ""
"Brīdinājums: -auroramiddle ir novecojis, tā vietā izmantojiet -aurorax 50.\n"

#, c-format
msgid "Warning: -auroraright is deprecated, use -aurorax 75 instead.\n"
msgstr ""
