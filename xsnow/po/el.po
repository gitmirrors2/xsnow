#, c-format
msgid "Configuration file: %s\n"
msgstr "Αρχείο διαμόρφωσης: %s\n"

#, c-format
msgid "Available languages are: %s\n"
msgstr "Οι διαθέσιμες γλώσσες είναι: %s\n"

msgid "Warning: don't eat yellow snow!"
msgstr "Προειδοποίηση: μην τρώτε κίτρινο χιόνι!"

#, c-format
msgid "For optimal results, add to your %s:\n"
msgstr "Για βέλτιστα αποτελέσματα, προσθέστε στο %s σας:\n"

#, c-format
msgid "unknown\n"
msgstr "άγνωστο\n"

#, c-format
msgid "Detected Wayland desktop\n"
msgstr "Εντοπίστηκε επιφάνεια εργασίας Wayland \n"

#, c-format
msgid "Xsnow needs gtk version >= %s, found version %s \n"
msgstr "Xsnow χρειάζεται έκδοση gtk >= %s, βρέθηκε η έκδοση %s \n"

msgid "Continuing with flag"
msgstr "Συνεχίζοντας με σημαία"

#, c-format
msgid "%s: cannot connect to X server %s\n"
msgstr "%s: δεν μπορεί να συνδεθεί στον διακομιστή X %s\n"

msgid "(default)"
msgstr "(Προκαθορισμένο)"

msgid "Configuration file: "
msgstr "Αρχείο διαμόρφωσης: "

msgid "restarting"
msgstr "επανεκκίνηση"

#, c-format
msgid "Click on a window ...\n"
msgstr "Κάντε κλικ σε ένα παράθυρο ...\n"

#, c-format
msgid "Detected desktop session: %s\n"
msgstr "Εντοπίστηκε περίοδος λειτουργίας επιφάνειας εργασίας: %s\n"

#, c-format
msgid "Could not determine desktop session\n"
msgstr ""
"Δεν ήταν δυνατός ο προσδιορισμός της συνεδρίας στην επιφάνεια εργασίας \n"

#, c-format
msgid "Trying to snow in root window\n"
msgstr "Προσπάθεια χιονιού στο root παράθυρο \n"

#, c-format
msgid "Using transparent window: %dx%d\n"
msgstr "Χρήση διαφανούς παραθύρου: %dx%d\n"

#, c-format
msgid "The transparent snow-window is probably not click-through, alas..\n"
msgstr "Το διαφανές χιόνι-παράθυρο μάλλον δεν είναι κλικ, δυστυχώς..\n"

#, c-format
msgid "Cannot create transparent window\n"
msgstr "Δεν είναι δυνατή η δημιουργία διαφανούς παραθύρου \n"

#, c-format
msgid "NOTE: xsnow will probably run, but some glitches are to be expected.\n"
msgstr ""
"ΣΗΜΕΙΩΣΗ: xsnow πιθανότατα θα εκτελεστεί, αλλά αναμένονται κάποιες "
"δυσλειτουργίες.\n"

#, c-format
msgid "LXDE session found, using window 'pcmanfm'.\n"
msgstr ""
"Βρέθηκε περίοδος λειτουργίας LXDE, χρησιμοποιώντας το παράθυρο 'pcmanfm'.\n"

#, c-format
msgid "Using window 'Desktop'.\n"
msgstr "Χρήση παραθύρου 'Desktop'.\n"

#, c-format
msgid "Using root window\n"
msgstr "Χρήση ριζικού παραθύρου \n"

#, c-format
msgid "Snowing in %#lx: %s size: %dx%d\n"
msgstr "Χιονίζει σε %#lx: %s μέγεθος: %dx%d\n"

#, c-format
msgid "Using double buffer: %#lx %dx%d\n"
msgstr "Χρήση διπλού buffer: %#lx %dx%d\n"

#, c-format
msgid "NOT using double buffering:"
msgstr "ΔΕΝ χρησιμοποιεί διπλό buffering:"

#, c-format
msgid " because double buffering is not available on this system\n"
msgstr ""
" επειδή η διπλή προσωρινή αποθήκευση δεν είναι διαθέσιμη σε αυτό το "
"σύστημα \n"

#, c-format
msgid " on your request.\n"
msgstr " κατόπιν αιτήματός σας. \n"

#, c-format
msgid "NOTE: expect some flicker.\n"
msgstr "ΣΗΜΕΙΩΣΗ: περιμένετε κάποιο τρεμόπαιγμα.\n"

msgid "Restart due to change of screen or language settings ...\n"
msgstr "Επανεκκίνηση λόγω αλλαγής ρυθμίσεων οθόνης ή γλώσσας ...\n"

msgid "Restart due to change of display settings...\n"
msgstr "Επανεκκίνηση λόγω αλλαγής των ρυθμίσεων οθόνης...\n"

msgid "Wayland (Expect some slugginess)"
msgstr "Wayland (Περιμένετε κάποια νωθρότητα)"

msgid "Probably X11"
msgstr "Μάλλον X11"

#, c-format
msgid "%s. Snow window: %#lx"
msgstr "%s. Παράθυρο χιονιού: %#lx"

#, c-format
msgid "More than %d errors, I quit!"
msgstr "Περισσότερα από %d σφάλματα, τα παράτησα!"

#, c-format
msgid "Window size changed, now snowing in in %#lx: %s %d+%d %dx%d\n"
msgstr ""
"Το μέγεθος του παραθύρου άλλαξε, τώρα χιονίζει σε %#lx: %s %d+%d %dx%d\n"

#, c-format
msgid "Halting because of flag %s\n"
msgstr "Παύση λόγω σημαίας %s\n"

#, c-format
msgid "Not sending tar file to terminal.\n"
msgstr "Δεν αποστέλλεται το αρχείο tar στο τερματικό.\n"

#, c-format
msgid "Try redirecting to a file (e.g: %s,\n"
msgstr "Δοκιμάστε να ανακατευθυνθείτε σε ένα αρχείο (π.χ.: %s,\n"

#, c-format
msgid "or use a %s"
msgstr "ή χρησιμοποιήστε ένα %s"

msgid "Problems encountered during production of the tar ball.\n"
msgstr "Προβλήματα που προέκυψαν κατά την παραγωγή της μπάλας πίσσας.\n"

#, c-format
msgid "Self replication is not compiled in.\n"
msgstr "Η αυτοανατύπωση δεν έχει μεταγλωττιστεί στο.\n"

#, c-format
msgid ""
"\n"
"Xsnow: Caught signal %d\n"
msgstr ""
"\n"
"Xsnow: Έπιασε σήμα %d\n"

#, c-format
msgid ""
"\n"
"Thanks for using xsnow\n"
msgstr ""
"\n"
"Ευχαριστούμε που χρησιμοποιείτε το xsnow\n"

#, c-format
msgid "Setting background from %s\n"
msgstr "Ρύθμιση φόντου από %s\n"

#, c-format
msgid "Range: %d\n"
msgstr "Εύρος: %d\n"

#, c-format
msgid "Mean distance: %3d\n"
msgstr "Μέση απόσταση: %3d\n"

#, c-format
msgid "Desktop type: %s"
msgstr "Τύπος επιφάνειας εργασίας: %s"

msgid "all monitors"
msgstr "όλες οι οθόνες"

#, c-format
msgid "monitor %d"
msgstr "οθόνη %d"

msgid "Available languages are: "
msgstr "Οι διαθέσιμες γλώσσες είναι: "

msgid "Use \"sys\" for your default language.\n"
msgstr "Χρησιμοποιήστε το \"sys\" για την προεπιλεγμένη γλώσσα σας.\n"

msgid "See also the man page."
msgstr "Δείτε επίσης τη σελίδα man."

#, c-format
msgid "Warning: '-auroraleft' is deprecated, using '-aurorax 25' .\n"
msgstr ""

#, c-format
msgid "Warning: '-auroramiddle' is deprecated, using '-aurorax 50' .\n"
msgstr ""

#, c-format
msgid "Warning: '-auroraright' is deprecated, using '-aurorax 75' .\n"
msgstr ""

msgid ""
"\n"
"Alas! This not an X11 session, xsnow will probably not run.\n"
"\n"
"If you want to try it anyway, set the environment variable XSNOW_FORCE_RUN, "
"eg:\n"
"\n"
"    XSNOW_FORCE_RUN=1 xsnow\n"
"\n"
"Or, you could force an X11 session, for example by tweaking /etc/gdm3/"
"daemon.conf.\n"
"\n"
msgstr ""
"\n"
" Αλίμονο! Αυτή δεν είναι μια περίοδος σύνδεσης X11, xsnow πιθανότατα δεν θα "
"εκτελεστεί.\n"
"\n"
"Αν θέλετε να το δοκιμάσετε ούτως ή άλλως, ορίστε τη μεταβλητή περιβάλλοντος\n"
"\n"
"     XSNOW_FORCE_RUN=1 xsnow\n"
"\n"
" Ή, θα μπορούσατε να επιβάλλετε μια περίοδο λειτουργίας X11, για παράδειγμα, "
"τροποποιώντας το /etc/gdm3/daemon.conf.\n"
"\n"

msgid "Ok, things are as they are. "
msgstr "Εντάξει, τα πράγματα είναι όπως έχουν. "

msgid ""
"If everything is ok, it is now snowing on your desktop, and birds are "
"flying. You are encouraged to define your own preferences using the tabs "
"above."
msgstr ""
"Αν όλα είναι εντάξει, τώρα χιονίζει στην επιφάνεια εργασίας σας και πουλιά "
"πετούν. Σας ενθαρρύνουμε να ορίσετε τις δικές σας προτιμήσεις "
"χρησιμοποιώντας τις παραπάνω καρτέλες."

msgid ""
"Use the <b>settings</b> tab if xsnow is misbehaving.\n"
"Use the <b>birds</b> tab if birds are misbehaving."
msgstr ""
"Χρησιμοποιήστε την καρτέλα <b>ρυθμίσεις</b> εάν το xsnow δεν συμπεριφέρεται "
"σωστά.\n"
" Χρησιμοποιήστε την καρτέλα <b>πουλιά</b> εάν τα πουλιά δεν συμπεριφέρονται "
"σωστά."

msgid "In every tab you find the following rescue buttons:"
msgstr "Σε κάθε καρτέλα βρίσκετε τα ακόλουθα κουμπιά διάσωσης:"

msgid "<b>Defaults </b>"
msgstr "<b>Προεπιλογές </b>"

msgid "Set default preferences for this tab."
msgstr "Ορίστε προεπιλεγμένες προτιμήσεις για αυτήν την καρτέλα."

msgid "<b>Vintage </b>"
msgstr "<b>Vintage </b>"

msgid "Set vintage preferences for this tab."
msgstr "Ορίστε vintage προτιμήσεις για αυτήν την καρτέλα."

msgid "<b>All defaults </b>"
msgstr "<b>Όλες οι προεπιλογές </b>"

msgid "Set default preferences for all (except settings) tabs."
msgstr ""
"Ορίστε προεπιλεγμένες προτιμήσεις για όλες τις καρτέλες (εκτός από τις "
"ρυθμίσεις)."

msgid "<b>All vintage </b>"
msgstr "<b>Όλα vintage </b>"

msgid "Set vintage preferences for all (except settings) tabs."
msgstr ""
"Ορίστε vintage προτιμήσεις για όλες τις καρτέλες (εκτός από τις ρυθμίσεις)."

msgid "  "
msgstr "  "

msgid "   "
msgstr "   "

msgid "Welcome at xsnow!"
msgstr "Καλώς ήρθατε στο xsnow!"

msgid ""
"Vintage preferences: the look and feel of the original xsnow, created in "
"1993 by Rick Jansen."
msgstr ""
"Vintage προτιμήσεις: η εμφάνιση και η αίσθηση του πρωτότυπου xsnow, που "
"δημιουργήθηκε το 1993 από τον Rick Jansen."

msgid "All defaults"
msgstr "Όλες οι προεπιλογές"

msgid ""
"Apply defaults for all preferences (except settings).\n"
"Flag: -defaults"
msgstr ""
"Εφαρμογή προεπιλογών για όλες τις προτιμήσεις (εκτός από τις ρυθμίσεις).\n"
"Flag: -defaults"

msgid "All vintage"
msgstr "Όλα vintage"

msgid ""
"Use vintage values for all preferences (except settings).\n"
"Flag: -vintage"
msgstr ""
"Χρησιμοποιήστε vintage τιμές για όλες τις προτιμήσεις (εκτός από τις "
"ρυθμίσεις).\n"
"Flag: -vintage"

msgid "Hide menu"
msgstr "Απόκρυψη μενού"

msgid ""
"Leave menu.\n"
"Flag: -nomenu"
msgstr ""
"Αποχώρηση από το μενού.\n"
"Flag: -nomenu"

msgid "Quit xsnow"
msgstr "Έξοδος xsnow"

msgid "Quit xsnow."
msgstr "Έξοδος xsnow."

msgid "Contact"
msgstr "Επικοινωνία"

msgid "Please report any comments to the maintainer of xsnow."
msgstr "Αναφέρετε τυχόν σχόλια στον συντηρητή του xsnow."

msgid ""
"If the system is too busy, all panels get this color, in which case you "
"could  adapt some settings in \"snow\", \"birds\", \"settings\", or "
"\"celestials\"."
msgstr ""
"Εάν το σύστημα είναι πολύ απασχολημένο, όλα τα πάνελ έχουν αυτό το χρώμα, "
"οπότε μπορείτε να προσαρμόσετε ορισμένες ρυθμίσεις στα \"χιόνι\", "
"\"πουλιά\", \"ρυθμίσεις\" ή \"ουράνια\"."

msgid "Welcome"
msgstr "καλως ΗΡΘΑΤΕ"

msgid "Blow off:"
msgstr "Παίρνω φυσώντας:"

msgid "On windows:"
msgstr "Στα παράθυρα:"

msgid "On bottom:"
msgstr "Στο κάτω μέρος:"

msgid "On scenery:"
msgstr "Στο τοπίο:"

msgid "Show"
msgstr "προβολή"

msgid ""
"If set, show snow blowing away.\n"
"Flags: -blowsnow, -noblowsnow"
msgstr ""
"Εάν έχει ρυθμιστεί, εμφανίστε το χιόνι που φυσάει.\n"
"Flags: -blowsnow, -noblowsnow"

msgid ""
"If set, show fallen snow on windows.\n"
"Flags: -keepsnowonwindows, -nokeepsnowonwindows"
msgstr ""
"Εάν έχει οριστεί, εμφανίστε το πεσμένο χιόνι στα παράθυρα.\n"
"Flags: -keepsnowonwindows, -nokeepsnowonwindows"

msgid ""
"If set, show fallen snow on bottom of the desktop.\n"
"Flags: -keepsnowonscreen, -nokeepsnowonscreen"
msgstr ""
"Εάν έχει οριστεί, εμφανίστε το πεσμένο χιόνι στο κάτω μέρος της επιφάνειας "
"εργασίας.\n"
"Flags: -keepsnowonscreen, -nokeepsnowonscreen"

msgid ""
"If set, snow will collect on the trees.\n"
"Flags: -keepsnowontrees, -nokeepsnowontrees"
msgstr ""
"Εάν ρυθμιστεί, θα μαζευτεί χιόνι στα δέντρα.\n"
"Flags: -keepsnowontrees, -nokeepsnowontrees"

msgid ""
"The higher this setting, the more snow will be generated  because of Santa "
"ploughing, wind or disappearing windows. \n"
"Flag: -blowofffactor"
msgstr ""
"Όσο υψηλότερη είναι αυτή η ρύθμιση, τόσο περισσότερο χιόνι θα δημιουργείται "
"λόγω του οργώματος του Άγιου Βασίλη, του αέρα ή των παραθύρων που "
"εξαφανίζονται. \n"
"Flag: -blowofffactor"

msgid ""
"The higher this setting, the more snow will collect on the windows. \n"
"Note: in Wayland, there is no snow on the windows. \n"
"Flag: -wsnowdepth"
msgstr ""
"Όσο υψηλότερη είναι αυτή η ρύθμιση, τόσο περισσότερο χιόνι θα μαζευτεί στα "
"παράθυρα. \n"
" Σημείωση: στο Wayland, δεν υπάρχει χιόνι στα παράθυρα. \n"
"Flag: -wsnowdepth"

msgid ""
"The higher this setting, the more snow will collect on the  bottom of the "
"desktop.\n"
"Flag: -ssnowdepth"
msgstr ""
"Όσο υψηλότερη είναι αυτή η ρύθμιση, τόσο περισσότερο χιόνι θα μαζεύεται στο "
"κάτω μέρος της επιφάνειας εργασίας.\n"
"Flag: -ssnowdepth"

msgid ""
"The higher this setting, the more snow will collect on the trees.\n"
"Flag: -maxontrees"
msgstr ""
"Όσο υψηλότερη είναι αυτή η ρύθμιση, τόσο περισσότερο χιόνι θα μαζεύεται στα "
"δέντρα.\n"
"Flag: -maxontrees"

msgid "Choose your favorite snow"
msgstr "Επιλέξτε το αγαπημένο σας χιόνι"

msgid " "
msgstr " "

msgid "Defaults"
msgstr "Προεπιλογές"

msgid "Apply default values for the preferences in this tab.\n"
msgstr ""
"Εφαρμόστε προεπιλεγμένες τιμές για τις προτιμήσεις σε αυτήν την καρτέλα.\n"

msgid "Vintage"
msgstr "Σοδειά"

msgid "Apply vintage values for the preferences in this tab."
msgstr "Εφαρμόστε vintage τιμές για τις προτιμήσεις σε αυτήν την καρτέλα."

msgid ""
"Apply defaults for all preferences (except settings).\n"
"Flags: -defaults"
msgstr ""
"Εφαρμογή προεπιλογών για όλες τις προτιμήσεις (εκτός από τις ρυθμίσεις).\n"
"Flags: -defaults"

msgid "Size:"
msgstr "Μέγεθος:"

msgid ""
"Size of snowflakes, works only for non-vintage snow flakes.\n"
"Flag: -snowsize"
msgstr ""
"Μέγεθος νιφάδων χιονιού, λειτουργεί μόνο για μη vintage νιφάδες χιονιού.\n"
"Flag: -snowsize"

msgid "Speed:"
msgstr "Ταχύτητα:"

msgid "Max # snowflakes:"
msgstr "Μέγιστο # νιφάδες χιονιού:"

msgid ""
"Maximum amount of snowflakes.\n"
"Flag: -flakecountmax"
msgstr ""
"Μέγιστη ποσότητα νιφάδων χιονιού.\n"
"Flag: -flakecountmax"

msgid "# Snowflakes:"
msgstr "# Νιφάδες χιονιού:"

msgid "label"
msgstr "επιγραφή"

msgid "Show fluff"
msgstr "Δείξτε χνούδι"

msgid ""
"If set, try to show fluff on fallen snow and trees if possible.\n"
"Flags: -fluffy, -nofluffy"
msgstr ""
"Εάν έχει ρυθμιστεί, προσπαθήστε να δείξετε χνούδι σε πεσμένο χιόνι και "
"δέντρα, αν είναι δυνατόν. \n"
"Flags: -fluffy, -nofluffy"

msgid "&#8195; &#8195; &#8195; &#8195; &#8195; &#8195; &#8195;"
msgstr "&#8195; &#8195; &#8195; &#8195; &#8195; &#8195; &#8195;"

msgid ""
"Speed of the snowflakes.\n"
"Flag: -snowspeedfactor"
msgstr ""
"Ταχύτητα των νιφάδων χιονιού.\n"
"Flag: -snowspeedfactor"

msgid "Intensity:"
msgstr "Ενταση:"

msgid ""
"The higher, the more snowflakes.\n"
"Flag: -snowflakes"
msgstr ""
"Όσο ψηλότερα, τόσο περισσότερες νιφάδες χιονιού.\n"
"Flag: -snowflakes"

msgid "Show snow"
msgstr "Εμφάνιση χιονιού"

msgid ""
"If set, show snowflakes.\n"
"Flags: -snow, -nosnow"
msgstr ""
"Εάν έχει οριστεί, εμφανίστε νιφάδες χιονιού.\n"
"Flags: -snow, -nosnow"

msgid ""
"The color of the snow.\n"
"Flag: -sc"
msgstr ""
"Το χρώμα του χιονιού.\n"
"Flag: -sc"

msgid "Color:"
msgstr "Χρώμα:"

msgid "Second color:"
msgstr "Δεύτερο χρώμα:"

msgid ""
"The second color of the snow.\n"
"Flag: -sc2"
msgstr ""
"Το δεύτερο χρώμα του χιονιού.\n"
"Flag: -sc2"

msgid "Enable"
msgstr "επιτρέπω"

msgid ""
"If set, use two colors.\n"
"Flag: -enablesc2"
msgstr ""
"Εάν έχει οριστεί, χρησιμοποιήστε δύο χρώματα.\n"
"Flag: -enablesc2"

msgid "Lift snow on windows or screen: click "
msgstr "Ανασηκώστε το χιόνι στα παράθυρα ή στην οθόνη: κάντε κλικ στο κουμπί "

msgid "Settings"
msgstr "Ρυθμίσεις"

msgid "Snow"
msgstr "Χιόνι"

msgid ""
"Tiny Santa with three reindeers.\n"
"Flags: -santa 0 -norudolph"
msgstr ""
"Μικροσκοπικός Άγιος Βασίλης με τρεις τάρανδους.\n"
"Flags: -santa 0 -norudolph"

msgid ""
"Small Santa with three reindeers.\n"
"Flags: -santa 1 -norudolph"
msgstr ""
"Μικρός Άγιος Βασίλης με τρεις τάρανδους.\n"
"Flags: -santa 1 -norudolph"

msgid ""
"Santa with three reindeers.\n"
"Flags: -santa 2 -norudolph"
msgstr ""
"Άγιος Βασίλης με τρεις τάρανδους.\n"
"Flags: -santa 2 -norudolph"

msgid ""
"Santa with Dasher, Dancer, Prancer, Vixen, Comet, Cupid, Dunder and Blixem.\n"
"Flags: -santa 3 -norudolph"
msgstr ""
"Άγιος Βασίλης με Dasher, Dancer, Prancer, Vixen, Comet, Cupid, Dunder και "
"Blixem.\n"
"Flags: -santa 3 -norudolph"

msgid ""
"Santa using the train with two reindeers.\n"
"Flags: -santa 4 -norudolph"
msgstr ""
"Ο Άγιος Βασίλης χρησιμοποιεί το τρένο με δύο τάρανδους.\n"
"Flags: -santa 4 -norudolph"

msgid ""
"Santa using the train with one reindeer and Rudolph.\n"
"Flags: -santa 4 -showrudolph"
msgstr ""
"Ο Άγιος Βασίλης χρησιμοποιεί το τρένο με έναν τάρανδο και τον Ρούντολφ.\n"
"Flags: -santa 4 -showrudolph"

msgid ""
"Tiny Santa with two reindeers and Rudolph.\n"
"Flags: -santa 0 -showrudolph"
msgstr ""
"Ο μικροσκοπικός Άγιος Βασίλης με δύο τάρανδους και τον Ρούντολφ.\n"
"Flags: -santa 0 -showrudolph"

msgid ""
"Small Santa with two reindeers and Rudolph.\n"
"Flags: -santa 1 -showrudolph"
msgstr ""
"Ο μικρός Άγιος Βασίλης με δύο τάρανδους και τον Ρούντολφ.\n"
"Flags: -santa 1 -showrudolph"

msgid ""
"Santa with two reindeers and Rudolph.\n"
"Flags: -santa 2 -showrudolph"
msgstr ""
"Ο Άγιος Βασίλης με δύο τάρανδους και τον Ρούντολφ.\n"
"Flags: -santa 2 -showrudolph"

msgid ""
"Santa with Dasher, Dancer, Prancer, Vixen, Comet, Cupid,  Dunder,  Blixem "
"and  Rudolph.\n"
"Flags: -santa 3 -showrudolph"
msgstr ""
"Άγιος Βασίλης με Dasher, Dancer, Prancer, Vixen, Comet, Cupid, Dunder, "
"Blixem και Rudolph.\n"
"Flags: -santa 3 -showrudolph"

msgid "Without Rudolph"
msgstr "Χωρίς τον Ρούντολφ"

msgid "With Rudolph"
msgstr "Με τον Ρούντολφ"

msgid "Choose your Santa"
msgstr "Επιλέξτε τον Άγιο Βασίλη σας"

