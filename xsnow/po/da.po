msgstr ""
"Systemet er for travlt, foreslå at sænke 'cpu-belastning' i 'indstillinger'\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr " eller se på 'sne': 'Intensitet', 'Maks. antal flager', ...\n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " eller angiv et mindre antal fugle i 'fugle'\n"

