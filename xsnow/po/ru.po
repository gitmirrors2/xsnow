msgstr "Установите винтажные настройки для этой вкладки."

msgid "<b>All defaults </b>"
msgstr "<b>Все значения по умолчанию </b>"

msgid "Set default preferences for all (except settings) tabs."
msgstr "Установите настройки по умолчанию для всех вкладок (кроме настроек)."

msgid "<b>All vintage </b>"
msgstr "<b>Все винтажные </b>"

