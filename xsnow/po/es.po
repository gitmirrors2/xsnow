msgstr "."

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"El sistema está demasiado ocupado, sugerimos reducir la 'carga de la CPU' en "
"'configuración\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr ""
" o eche un vistazo a 'nieve': 'Intensidad', 'Número máximo de copos', ...\n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " o especifique un número menor de aves en 'aves'\n"

