msgid "en"
msgstr "en"

msgid "it"
msgstr "to"

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"Systém je příliš zaneprázdněn, navrhněte snížit 'Faktor CPU' v 'Nastaveni'\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr ""
" nebo se podívejte na 'sníh': 'Intenzita', 'Maximálně # sněhových "
"vloček', ...\n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " nebo zadejte menší počet ptáků v 'ptactvo'\n"

