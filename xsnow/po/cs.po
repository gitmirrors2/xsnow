msgid "Using double buffer: %#lx %dx%d\n"
msgstr "Použití dvojité vyrovnávací paměti: %#lx %dx%d\n"

#, c-format
msgid "NOT using double buffering:"
msgstr "NEPOUŽÍVEJTE dvojité ukládání do vyrovnávací paměti:"

#, c-format
msgid " because double buffering is not available on this system\n"
msgstr ""
" protože dvojité ukládání do vyrovnávací paměti není v tomto systému k "
"dispozici\n"

#, c-format
msgid " on your request.\n"
msgstr " na vaši žádost.\n"

#, c-format
msgid "NOTE: expect some flicker.\n"
msgstr "POZNÁMKA: očekávejte nějaké blikání.\n"

msgid "Restart due to change of screen or language settings ...\n"
msgstr "Restartovat kvůli změně nastavení obrazovky nebo jazyka ...\n"

msgid "Restart due to change of display settings...\n"
msgstr "Restartovat kvůli změně nastavení displeje...\n"

msgid "Wayland (Expect some slugginess)"
msgstr "Wayland (očekávejte nějakou pomalost)"

msgid "Probably X11"
msgstr "Pravděpodobně X11"

#, c-format
msgid "%s. Snow window: %#lx"
msgstr "%s. Sněhové okno: %#lx"

#, c-format
msgid "More than %d errors, I quit!"
msgstr "Více než %d chyb, končím!"

#, c-format
msgid "Window size changed, now snowing in in %#lx: %s %d+%d %dx%d\n"
msgstr "Velikost okna změněna, nyní sněží v %#lx: %s %d+%d %dx%d\n"

#, c-format
msgid "Halting because of flag %s\n"
msgstr "Zastavení kvůli příznaku %s\n"

#, c-format
msgid "Not sending tar file to terminal.\n"
msgstr "Neposílám soubor tar do terminálu.\n"

#, c-format
msgid "Try redirecting to a file (e.g: %s,\n"
msgstr "Zkuste přesměrovat na soubor (např.: %s,\n"

#, c-format
msgid "or use a %s"
msgstr "nebo použijte %s"

msgid "Problems encountered during production of the tar ball.\n"
msgstr "Problémy při výrobě dehtové koule.\n"

#, c-format
msgid "Self replication is not compiled in.\n"
msgstr "Vlastní replikace není zkompilována. \n"

