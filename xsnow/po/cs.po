#~ msgstr "Upozornění: '-auroraleft' je zastaralé, používá '-aurorax 25' .\n"

#, c-format
#~ msgid "Warning: '-auroramiddle' is deprecated, using '-aurorax 50' .\n"
#~ msgstr "Upozornění: '-auroramiddle' je zastaralé, používá '-aurorax 50' .\n"

