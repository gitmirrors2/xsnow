msgid "NOTE: xsnow will probably run, but some glitches are to be expected.\n"
msgstr ""
"POZNÁMKA: xsnow pravděpodobně poběží, ale lze očekávat nějaké závady.\n"

#, c-format
msgid "LXDE session found, using window 'pcmanfm'.\n"
msgstr "Byla nalezena relace LXDE pomocí okna 'pcmanfm'.\n"

#, c-format
msgid "Using window 'Desktop'.\n"
msgstr "Pomocí okna 'Desktop'. \n"

#, c-format
msgid "Using root window\n"
msgstr "Použití kořenového okna \n"

#, c-format
msgid "Snowing in %#lx: %s size: %dx%d\n"
msgstr "Sněží v %#lx: %s velikost: %dx%d\n"

