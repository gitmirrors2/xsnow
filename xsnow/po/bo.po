msgstr "ཐ་སྙད་འདས་མ་ཐག་པའི་དངོས་པོ་དང་སྐྱེས་བུའི་མིང་ཚབ་ལ་འཇུག"

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"མ་ལག་དེ་ཧ་ཅང་བྲེལ་འཚུབ་ཆེ། 'settings'ནང་ 'cpu load' མར་ཕབ་དགོས་པའི་བསམ་འཆར་འདོན་གྱི་"
"ཡོད།\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr " ཡང་ན་'གངས་'ལ་ལྟོས། 'ཤུགས་ཚད་', 'ཆེས་མཐོའི་ཕྲེང་བ', ...\n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " ཡང་ན་ 'birds' ནང་བྱ་གྲངས་ཆུང་བ་གཏན་འཁེལ་བྱེད།\n"

