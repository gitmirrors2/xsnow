#, c-format
msgid "Configuration file: %s\n"
msgstr "རིམ་སྒྲིག་ཡིག་ཆ།: %s\n"

#, c-format
msgid "Available languages are: %s\n"
msgstr ""
"སྤྱོད་ཐུབ་པའི་སྐད་ཡིག་ནི། %s\n"
" ཡིན།\n"

msgid "Warning: don't eat yellow snow!"
msgstr "ཉེན་བརྡ། གངས་ཀྱི་སེར་པོ་མ་ཟོས།"

#, c-format
msgid "For optimal results, add to your %s:\n"
msgstr "ལེགས་ཤོས་ཀྱི་གྲུབ་འབྲས་ཆེད་དུ་ཁྱེད་རང་གི་ %s:ལ་ཁ་སྣོན་བྱེད་དགོས།\n"

#, c-format
msgid "unknown\n"
msgstr "མ་ཤེས་\n"

#, c-format
msgid "Detected Wayland desktop\n"
msgstr ""
"ཝེ་ལེནཌ་ཌེཀ་སི་ཊོཔ་\n"
" ཤེས་རྟོགས་བྱུང་།\n"

#, c-format
msgid "Xsnow needs gtk version >= %s, found version %s \n"
msgstr "Xsnow ལ་ gtk ཐོན་རིམ་ >= %s དགོས་འདུག ཐོན་རིམ་ %s རྙེད།\n"

msgid "Continuing with flag"
msgstr "དར་ཆ་མུ་མཐུད།"

#, c-format
msgid "%s: cannot connect to X server %s\n"
msgstr "%s: Xསར་བར་ %s ལ་མཐུད་མི་ཐུབ།\n"

msgid "(default)"
msgstr "(ལུགས་འགལ)"

msgid "Configuration file: "
msgstr "རིམ་སྒྲིག་ཡིག་ཆ། "

msgid "restarting"
msgstr "བསྐྱར་འགོ་འཛུགས་པ།"

#, c-format
msgid "Click on a window ...\n"
msgstr "སྒེའུ་ཁུང་ཞིག་ལ་སྣུན། ...\n"

#, c-format
msgid "Detected desktop session: %s\n"
msgstr "ཤེས་རྟོགས་བྱུང་བའི་ཌེཀ་སི་ཊོབ་ལས་རིམ་: %s\n"

#, c-format
msgid "Could not determine desktop session\n"
msgstr ""
"ཌེཀ་སི་ཊོབ་ལས་རིམ་\n"
" གཏན་འཁེལ་བྱེད་མི་ཐུབ།\n"

#, c-format
msgid "Trying to snow in root window\n"
msgstr ""
"རྩ་བའི་སྒེའུ་ཁུང་\n"
"ནང་གངས་ཀྱི་ཚོད་ལྟ་བྱེད་བཞིན་ཡོད།\n"

#, c-format
msgid "Using transparent window: %dx%d\n"
msgstr "དྭངས་གསལ་གྱི་སྒེའུ་ཁུང་སྤྱད་དེ: %dx%d\n"

#, c-format
msgid "The transparent snow-window is probably not click-through, alas..\n"
msgstr "དྭངས་གསལ་གྱི་གངས་ཀྱི་སྒེའུ་ཁུང་དེ་ཕལ་ཆེར་སྣུན་ཐུབ་ཀྱི་མ་རེད། ཡིན་ནའང་། \n"

#, c-format
msgid "Cannot create transparent window\n"
msgstr "དྭངས་གསལ་གྱི་སྒེའུ་ཁུང་གསར་སྐྲུན་བྱེད་མི་ཐུབ།\n"

#, c-format
msgid "NOTE: xsnow will probably run, but some glitches are to be expected.\n"
msgstr "དྲན་ཐོ། xsnow ཕལ་ཆེར་གཡོག་རྒྱུ་ཡིན་མོད། འོན་ཀྱང་སྐྱོན་ཆ་འགའ་ཤས་རེ་བ་བྱེད་ཀྱི་ཡོད། \n"

#, c-format
msgid "LXDE session found, using window 'pcmanfm'.\n"
msgstr ""
"སྒེའུ་ཁུང་'pcmanfm'.\n"
"བཀོལ་ནས་LXDEལས་རིམ་རྙེད་སོང་།\n"

#, c-format
msgid "Using window 'Desktop'.\n"
msgstr "'ཌེཀ་སི་ཊོཔ' སྒེའུ་ཁུང་བེད་སྤྱོད་བྱེད་བཞིན་ཡོད།\n"

#, c-format
msgid "Using root window\n"
msgstr ""
"རྩ་བའི་སྒེའུ་ཁུང་\n"
"བེད་སྤྱོད་བྱེད་བཞིན་ཡོད།\n"

#, c-format
msgid "Snowing in %#lx: %s size: %dx%d\n"
msgstr "%#lx: %s ནང་ཁ་བ་འབབ་བཞིན་འདུག ཆེ་ཆུང་: %dx%d\n"

#, c-format
msgid "Using double buffer: %#lx %dx%d\n"
msgstr "བར་སྟོང་གཉིས་ལྡན་བཀོལ་སྤྱོད་བྱེད་པ།: %#lx %dx%d\n"

#, c-format
msgid "NOT using double buffering:"
msgstr "བར་སྟོང་གཉིས་བེད་སྤྱོད་མི་བྱེད།"

#, c-format
msgid " because double buffering is not available on this system\n"
msgstr " གང་ལགས་ཤེ་ན། མ་ལག་འདིའི་སྟེང་ལ་བར་སྟོང་གཉིས་ལྡན་མེད།\n"

#, c-format
msgid " on your request.\n"
msgstr " ཁྱེད་ཀྱི་རེ་འདུན་ལྟར།\n"

#, c-format
msgid "NOTE: expect some flicker.\n"
msgstr "དྲན་ཐོ། འོད་མདངས་འགའ་ཤས་རེ་བ་བྱེད། \n"

msgid "Restart due to change of screen or language settings ...\n"
msgstr "བརྙན་ཤེལ་ཡང་ན་སྐད་ཡིག་གི་སྒྲིག་སྟངས་བསྒྱུར་བའི་རྐྱེན་གྱིས་བསྐྱར་དུ་འགོ་འཛུགས། ...\n"

msgid "Wayland (Expect some slugginess)"
msgstr "ཝེ་ལན་ཌི། (མགྱོགས་པོ་འགའ་ཤས་རེ་བ་བྱེད།)"

msgid "Probably X11"
msgstr "ཕལ་ཆེར་X11"

#, c-format
msgid "%s. Snow window: %#lx"
msgstr "%s. གངས་ཀྱི་སྒེའུ་ཁུང་: %#lx"

#, c-format
msgid "More than %d errors, I quit!"
msgstr "ནོར་འཁྲུལ་%dལས་མང་བ་བྱུང་། ངས་མཚམས་འཇོག་བྱས།"

#, c-format
msgid "Window size changed, now snowing in in %#lx: %s %d+%d %dx%d\n"
msgstr "སྒེའུ་ཁུང་གི་ཚད་བསྒྱུར་འདུག ད་ལྟ་ཁ་བ་འབབ་བཞིན་འདུག %#lx: %s %d+%d %dx%d\n"

#, c-format
msgid "Halting because of flag %s\n"
msgstr ""
"%s\n"
" རྒྱལ་དར་གྱི་རྐྱེན་གྱིས་མཚམས་འཇོག\n"

#, c-format
msgid "Not sending tar file to terminal.\n"
msgstr "ཊར་ཡིག་ཆ་དེ་ཊར་མི་ནཱལ་ལ་གཏོང་གི་མེད།\n"

#, c-format
msgid "Try redirecting to a file (e.g: %s,\n"
msgstr "ཡིག་ཆ་ཞིག་ལ་བསྐྱར་ལོག་བྱེད་པར་འབད་བརྩོན་བྱོས།(དཔེར་ན།: %s,\n"

#, c-format
msgid "or use a %s"
msgstr "ཡང་ན་ %s བེད་སྤྱོད།"

msgid "Problems encountered during production of the tar ball.\n"
msgstr "ཏར་སྤོ་ལོ་བཟོ་སྐྲུན་བྱེད་སྐབས་འཕྲད་པའི་དཀའ་ངལ།\n"

#, c-format
msgid "Self replication is not compiled in.\n"
msgstr "རང་འགུལ་འདྲ་བཤུས་དེ་ནང་དུ་བསྡུ་རུབ་བྱས་མེད།\n"

#, c-format
msgid ""
"\n"
"Xsnow: Caught signal %d\n"
msgstr ""
"\n"
"\n"
": འཛིན་བཟུང་བརྡ་རྟགས་%d\n"

#, c-format
msgid ""
"\n"
"Thanks for using xsnow\n"
msgstr ""
"\n"
"xsnow\n"
"བེད་སྤྱོད་བྱས་པར་ཐུགས་རྗེ་ཆེ།\n"

#, c-format
msgid "Setting background from %s\n"
msgstr ""
"%s\n"
" ནས་རྒྱབ་ལྗོངས་སྒྲིག་བཀོད་བྱེད་པ།\n"

#, c-format
msgid "Range: %d\n"
msgstr "ཁྱབ་ཁོངས།: %d\n"

#, c-format
msgid "Mean distance: %3d\n"
msgstr "ཆ་སྙོམས་བར་ཐག་: %3d\n"

#, c-format
msgid "Desktop type: %s"
msgstr "ཌེཀ་སི་ཊོབ་རིགས་: %s"

msgid "all monitors"
msgstr "ལྟ་རྟོག་པ་ཚང་མ།"

#, c-format
msgid "monitor %d"
msgstr "ལྟ་རྟོག %d"

msgid "Available languages are: "
msgstr "སྤྱོད་ཐུབ་པའི་སྐད་ཡིག་ནི། "

msgid "Use \"sys\" for your default language.\n"
msgstr "ཁྱེད་རང་གི་སྔོན་སྒྲིག་སྐད་ཡིག་ལ་\"sys\"བེད་སྤྱོད་བྱེད།\n"

msgid "See also the man page."
msgstr "མི་ཤོག་ངོས་ལ་ཡང་གཟིགས།"

#, c-format
msgid "Warning: -auroraleft is deprecated, use -aurorax 25 instead.\n"
msgstr "ཉེན་བརྡ། -auroraleft བེད་སྤྱོད་མེད་པར་གྱུར་ཡོད། དེའི་ཚབ་ཏུ་ -aurorax 25 བེད་སྤྱོད་བྱེད།\n"

#, c-format
msgid "Warning: -auroramiddle is deprecated, use -aurorax 50 instead.\n"
msgstr "ཉེན་བརྡ། -ཨོ་རོ་རཱ་མིཌལ་བེད་སྤྱོད་མེད་པར་གྱུར་ཡོད། དེའི་ཚབ་ཏུ་-ཨོ་རོ་རེག་སི་༥༠བེད་སྤྱོད་བྱེད།\n"

#, c-format
msgid "Warning: -auroraright is deprecated, use -aurorax 75 instead.\n"
msgstr "ཉེན་བརྡ། -ཨོ་རོ་རའིཊ་བེད་སྤྱོད་མེད་པར་གྱུར་ཡོད། དེའི་ཚབ་ཏུ་-ཨོ་རོ་རེག་སི་75བེད་སྤྱོད་བྱེད།\n"

msgid ""
"\n"
"Alas! This not an X11 session, xsnow will probably not run.\n"
"\n"
"If you want to try it anyway, set the environment variable XSNOW_FORCE_RUN, "
"eg:\n"
"\n"
"    XSNOW_FORCE_RUN=1 xsnow\n"
"\n"
"Or, you could force an X11 session, for example by tweaking /etc/gdm3/"
"daemon.conf.\n"
"\n"
msgstr ""
"\n"
"ཨ་ཡ། \n"
"འདི་ནི་X11ལས་རིམ་མིན་པས་xsnowཕལ་ཆེར་གཡོག་མི་ཐུབ།\n"
"\n"
"གལ་ཏེ་ཁྱེད་ཀྱིས་གང་ལྟར་ཡང་ཚོད་ལྟ་བྱེད་འདོད་ན་ཁོར་ཡུག་འགྱུར་ཅན་XSNOW_FORCE_RUN དཔེར་ན།:\n"
"\n"
"སྒྲིག་དགོས། XSNOW_FORCE_RUN=1 xsnow\n"
"\n"
"ཡང་ན་ཁྱེད་ཀྱིས་X11ལས་རིམ་བཙན་ཤེད་བྱེད་ཐུབ། དཔེར་ན། /etc/gdm3/daemon.conf.\n"

msgid "Ok, things are as they are. "
msgstr "ཡོང་ང་།དངོས་པོ་དེ་དག་སྔར་བཞིན་རེད། "

msgid ""
"If everything is ok, it is now snowing on your desktop, and birds are "
"flying. You are encouraged to define your own preferences using the tabs "
"above."
msgstr ""
"གལ་ཏེ་ཡོད་ཚད་བདེ་པོ་ཡོད་ན། ད་ལྟ་ཁྱེད་ཀྱི་ཡིག་ཆའི་སྟེང་ལ་གངས་ཀྱི་འབབ་བཞིན་ཡོད་པ་དང་། བྱིའུ་འཕུར་བཞིན་"
"ཡོད། ཁྱེད་རང་གིས་གོང་དུ་བཀོད་པའི་མཆོང་ལྡེ་བེད་སྤྱད་དེ་རང་ཉིད་ཀྱི་དགའ་མོས་གཏན་འབེབས་བྱེད་པར་སྐུལ་མ་བྱེད་"
"ཀྱི་ཡོད།"

msgid ""
"Use the <b>settings</b> tab if xsnow is misbehaving.\n"
"Use the <b>birds</b> tab if birds are misbehaving."
msgstr ""
"གལ་ཏེ་ xsnow ནོར་འཁྲུལ་ཅན་ཡིན་ན་ <b>སྒྲིག་སྟངས་</b> མཆོང་ལྡེ་བེད་སྤྱོད་བྱེད།\n"
"གལ་ཏེ་བྱ་སྤྱོད་ངན་པ་ཡོད་ན་ <b>བྱིའུ་</b> མཆོང་ལྡེ་བེད་སྤྱོད་བྱེད།"

msgid "In every tab you find the following rescue buttons:"
