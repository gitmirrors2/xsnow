msgstr "མཆན་གང་ཡོད་ན་ xsnow བདག་གཉེར་བྱེད་མཁན་ལ་སྙན་སེང་ཞུ་རོགས།"

msgid ""
"If the system is too busy, all panels get this color, in which case you "
"could  adapt some settings in \"snow\", \"birds\", \"settings\", or "
"\"celestials\"."
msgstr ""
"གལ་ཏེ་མ་ལག་དེ་ཧ་ཅང་བྲེལ་འཚུབ་ཆེ་ན། ཕྲ་རིང་ཚང་མར་ཚོས་གཞི་འདི་ཐོབ་ཀྱི་ཡོད། དེ་ལྟར་བྱས་ན་ཁྱེད་ཀྱིས་"
"\"ཁ་བ\", \"བྱིའུ།\", \"སྒྲིག་སྟངས།\", ཡང་ན་\"མཁའ་དབྱིངས་རིགས།\" ནང་སྒྲིག་སྟངས་འགའ་ཤས་བསྒྱུར་"
"ཐུབ།"

msgid "Welcome"
msgstr "དགའ་བསུ"

msgid "Blow off:"
msgstr "འཕུར།"

msgid "On windows:"
msgstr "སྒེའུ་ཁུང་སྟེང་།"

msgid "On bottom:"
msgstr "མཇུག་ཏུ།"

msgid "On scenery:"
msgstr "ཡུལ་ལྗོངས་སྟེང་།"

msgid "Show"
msgstr "མངོན་སྟོན"

msgid ""
"If set, show snow blowing away.\n"
"Flags: -blowsnow, -noblowsnow"
msgstr ""
"གལ་ཏེ་སྒྲིག་ན་གངས་ཀྱིས་འཕུར་བཞིན་པ་སྟོན།\n"
"Flags: -blowsnow, -noblowsnow"

msgid ""
"If set, show fallen snow on windows.\n"
"Flags: -keepsnowonwindows, -nokeepsnowonwindows"
msgstr ""
"གལ་ཏེ་སྒྲིག་ཡོད་ན། སྒེའུ་ཁུང་སྟེང་དུ་གངས་ཀྱི་ཆར་ལྷུང་བ་སྟོན།\n"
"Flags: -keepsnowonwindows, -nokeepsnowonwindows"

msgid ""
"If set, show fallen snow on bottom of the desktop.\n"
"Flags: -keepsnowonscreen, -nokeepsnowonscreen"
msgstr ""
"གལ་ཏེ་སྒྲིག་ཡོད་ན། ཡིག་ཆའི་མཐིལ་དུ་ཁ་བ་བབས་པ་སྟོན།\n"
"Flags: -keepsnowonscreen, -nokeepsnowonscreen"

msgid ""
"If set, snow will collect on the trees.\n"
"Flags: -keepsnowontrees, -nokeepsnowontrees"
msgstr ""
"གལ་ཏེ་སྒྲིག་ན་ཤིང་སྡོང་སྟེང་གངས་ཀྱིས་བསྡུ་རུབ་བྱེད།\n"
"Flags: -keepsnowontrees, -nokeepsnowontrees"

msgid ""
"The higher this setting, the more snow will be generated  because of Santa "
"ploughing, wind or disappearing windows. \n"
"Flag: -blowofffactor"
msgstr ""
"སྒྲིག་སྟངས་འདི་མཐོ་རུ་འགྲོ་ཚེ། སན་ཊ་ཡིས་ས་ཞིང་འདེབས་པ་དང་། རླུང་། ཡང་ན་སྒེའུ་ཁུང་ཡལ་འགྲོ་བ་སོགས་ཀྱི་"
"རྐྱེན་གྱིས་གངས་ཀྱིས་གང་མང་ཐོན་རྒྱུ་རེད། \n"
"Flag: -blowofffactor"

msgid ""
"The higher this setting, the more snow will collect on the windows. \n"
"Note: in Wayland, there is no snow on the windows. \n"
"Flag: -wsnowdepth"
msgstr ""
"སྒྲིག་སྟངས་འདི་མཐོ་རུ་སོང་ན་སྒེའུ་ཁུང་སྟེང་དུ་གངས་ཀྱིས་མང་བ་བསྡུ་རུབ་བྱེད། \n"
"མཆན: ཝེ་ལེནཌ་ནང་སྒེའུ་ཁུང་སྟེང་ལ་གངས་མེད། \n"
"Flag: -wsnowdepth"

msgid ""
"The higher this setting, the more snow will collect on the  bottom of the "
"desktop.\n"
"Flag: -ssnowdepth"
msgstr ""
"སྒྲིག་སྟངས་འདི་མཐོ་རུ་སོང་ན་ཡིག་ཆའི་མཐིལ་དུ་གངས་ཀྱིས་མང་བ་བསྡུ་རུབ་བྱེད།\n"
"Flag: -ssnowdepth"

msgid ""
"The higher this setting, the more snow will collect on the trees.\n"
"Flag: -maxontrees"
msgstr ""
"སྒྲིག་སྟངས་འདི་མཐོ་རུ་སོང་ན་ཤིང་སྡོང་སྟེང་དུ་གངས་ཀྱིས་མང་པོ་བསྡུ་རུབ་བྱེད།\n"
"Flag: -maxontrees"

