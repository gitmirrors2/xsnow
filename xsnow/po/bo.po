"Flags: -santa 3 -norudolph"
msgstr ""
"སན་ཊ་དང་ཌ་ཤར་དང་། ཞབས་བྲོ། པྲན་སར། ཝི་ཁེན། སྐར་མདའ་། ཀུ་པིཌ། ཌན་ཌར་དང་བི་ལི་སེམ་བཅས་"
"ཡོད།\n"
"Flags: -santa 3 -norudolph"

msgid ""
"Santa using the train with two reindeers.\n"
"Flags: -santa 4 -norudolph"
msgstr ""
"སན་ཏ་ཡིས་གླང་ཆེན་གཉིས་དང་མཉམ་དུ་མེ་འཁོར་བེད་སྤྱོད་བྱེད་བཞིན་ཡོད།\n"
"Flags: -santa 4 -norudolph"

msgid ""
"Santa using the train with one reindeer and Rudolph.\n"
"Flags: -santa 4 -showrudolph"
msgstr ""
"སན་ཏ་ཡིས་གླང་ཆེན་གཅིག་དང་རུ་ཌོལ་ཕི་དང་མཉམ་དུ་མེ་འཁོར་བེད་སྤྱོད་བྱེད་བཞིན་ཡོད།\n"
"Flags: -santa 4 -showrudolph"

msgid ""
"Tiny Santa with two reindeers and Rudolph.\n"
"Flags: -santa 0 -showrudolph"
msgstr ""
"སན་ཊ་ཆུང་ཆུང་དེ་གླང་ཆེན་གཉིས་དང་རུ་ཌོལ་ཕ།\n"
"Flags: -santa 0 -showrudolph"

msgid ""
"Small Santa with two reindeers and Rudolph.\n"
"Flags: -santa 1 -showrudolph"
msgstr ""
"སན་ཊ་ཆུང་ཆུང་དང་གླང་ཆེན་གཉིས་དང་རུ་ཌོལ་ཕ།\n"
"Flags: -santa 1 -showrudolph"

msgid ""
"Santa with two reindeers and Rudolph.\n"
"Flags: -santa 2 -showrudolph"
msgstr ""
"སན་ཏ་གཅན་གཟན་གཉིས་དང་རུ་ཌོལ་ཕ། \n"
"Flags: -santa 2 -showrudolph"

msgid ""
"Santa with Dasher, Dancer, Prancer, Vixen, Comet, Cupid,  Dunder,  Blixem "
"and  Rudolph.\n"
"Flags: -santa 3 -showrudolph"
msgstr ""
"སན་ཊ་དེ་ཌ་ཤར་དང་། ཞབས་བྲོ། པྲན་སར། ཝི་སེན། སྐར་མདའ་། ཀུ་པིཌ། ཌན་ཌར། བི་ལི་སེམ་དང་རུ་ཌོལ་ཕ་"
"བཅས་དང་མཉམ་དུ་ཡོད།\n"
"Flags: -santa 3 -showrudolph"

msgid "Without Rudolph"
msgstr "རུ་ཌོལ་ཕི་མེད་ན།"

msgid "With Rudolph"
msgstr "རུ་ཌོལ་ཕི་དང་མཉམ་དུ།"

msgid "Choose your Santa"
msgstr "ཁྱེད་རང་གི་སན་ཊ་འདེམས།"

msgid "Choose your favorite Santa"
msgstr "ཁྱེད་རང་དགའ་ཤོས་སན་ཊ་འདེམས།"

msgid "    "
msgstr "    "

msgid ""
"Santa's speed.\n"
"Flag: -santaspeedfactor"
msgstr ""
"སན་ཊའི་མགྱོགས་ཚད།\n"
"Flag: -santaspeedfactor"

msgid "Apply default values for the preferences in this tab."
msgstr "མཆོང་ལྡེ་འདིའི་ནང་གི་དགའ་མོས་ཆེད་དུ་སྔོན་སྒྲིག་གནས་གོང་འཇུག་སྤྱོད་བྱེད།"

msgid "Show Santa"
msgstr "སན་ཏ་སྟོན།"

msgid ""
"To show or not to show Santa.\n"
"Flags: -showsanta, -nosanta"
msgstr ""
"སན་ཊ་སྟོན་དགོས་སམ་མི་སྟོན་དགོས།\n"
"Flags: -showsanta, -nosanta"

msgid "&#8195; &#8195; &#8195; &#8195; &#8195; &#8195; &#8195;"
msgstr "&#8195; &#8195; &#8195; &#8195; &#8195; &#8195; &#8195;."

msgid "Scale:"
msgstr "ཤུན་སྐོགས་སྲབ་མོ:"

msgid ""
"Scale of Santa.\n"
"Flags: -santascale <n>"
msgstr ""
"སན་ཊའི་ཚད་གཞི།\n"
"Flags: -santascale <n>"

msgid "Santa"
msgstr "སན་ཊ།"

msgid "Show  scenery"
msgstr "མཛེས་ལྗོངས་སྟོན་པ།"

msgid ""
"To show or not to show scenery.\n"
"Flags: -showtrees, -notrees"
msgstr ""
"ཡུལ་ལྗོངས་སྟོན་པའམ་མི་སྟོན།\n"
"Flags: -showtrees, -notrees"

msgid ""
"Vintage tree, you can set the color.\n"
"Flag: -treetype 0"
msgstr ""
"རྙིང་མའི་ཤིང་སྡོང་། ཁྱོད་ཀྱིས་ཚོས་གཞི་སྒྲིག་ཐུབ།\n"
"Flag: -treetype 0"

msgid ""
"Woody tree.\n"
"Flags: -treetype 1 or: -treetype all"
msgstr ""
"ཤིང་སྡོང་།\n"
"Flags: -treetype 1 or: -treetype all"

msgid ""
"Leavy tree.\n"
"Flags: -treetype 2 or: -treetype all"
msgstr ""
"ལོ་མ་ཅན་གྱི་ཤིང་སྡོང་།\n"
"Flags: -treetype 2 or: -treetype all"

msgid ""
"Small house.\n"
"Flags: -treetype 3 or: -treetype all"
msgstr ""
"ཁང་པ་ཆུང་ཆུང་།\n"
"Flags: -treetype 3 or: -treetype all"

msgid ""
"Reindeer.\n"
"Flags: -treetype 4 or: -treetype all"
msgstr ""
"གཅན་གཟན།\n"
"Flags: -treetype 4 or: -treetype all"

msgid ""
"Moose.\n"
"Flags: -treetype 5 or: -treetype all"
msgstr ""
"མོ་སི།\n"
"Flags: -treetype 5 or: -treetype all"

msgid ""
"Snowy tree.\n"
"Flags: -treetype 6 or: -treetype all"
msgstr ""
"གངས་ཀྱི་ཤིང་སྡོང་།\n"
"Flags: -treetype 6 or: -treetype all"

msgid ""
"Set color of vintage tree.\n"
"Flag: -tc"
msgstr ""
"རྒུན་འབྲུམ་གྱི་ཤིང་སྡོང་གི་ཚོས་གཞི་སྒྲིག་དགོས།\n"
"Flag: -tc"

msgid "Compose your favorite scenery"
msgstr "རང་ཉིད་དགའ་སའི་མཛེས་ལྗོངས་བརྩམས།"

msgid "Try and click any image!"
msgstr "ཚོད་ལྟ་བྱས་ནས་པར་རིས་གང་རུང་ཞིག་ལ་སྣུན་རོགས།"

msgid ""
"Polar bear.\n"
"Flags: -treetype 7 or: -treetype all"
msgstr ""
"བྱང་སྣེའི་དོམ།\n"
"Flags: -treetype 7 or: -treetype all"

msgid "# Items:"
msgstr "# རྣམ་གྲངས:"

msgid ""
"Desired number of scenery items.\n"
"Flag: -trees"
msgstr ""
"འདོད་པའི་མཛེས་ལྗོངས་རྣམ་གྲངས་ཀྱི་གྲངས་འབོར།\n"
"Flag: -trees"

msgid "% Window fill:"
msgstr "% སྒེའུ་ཁུང་བཀང་ཚད།"

msgid ""
"Bottom percentage of screen available for scenery.\n"
"Flag: -treefill"
msgstr ""
"མཛེས་ལྗོངས་ཆེད་དུ་གློག་བརྙན་གྱི་གཤམ་གྱི་བརྒྱ་ཆ།\n"
"Flag: -treefill"

msgid "Allow overlap"
msgstr "བརྗེ་རེས་བྱེད་དུ་འཇུག་པ།"

msgid ""
"To allow overlap or not when placing scenery.\n"
"Flags: -treeoverlap, -notreeoverlap"
msgstr ""
"ཡུལ་ལྗོངས་འཇོག་སྐབས་བརྗེ་རེས་བྱེད་ཆོག་པའམ་མི་བྱེད་པ།\n"
"Flags: -treeoverlap, -notreeoverlap"

msgid ""
"Scale of scenery.\n"
"Flag: sceneryscale <n>"
msgstr ""
"ཡུལ་ལྗོངས་ཀྱི་ཚད་གཞི།\n"
"Flag: sceneryscale <n>"

msgid "Scenery"
msgstr "ཡུལ་ལྗོངས"

msgid "Compose here your favorite celestial conditions"
msgstr "འདིར་ཁྱེད་རང་དགའ་ཤོས་ཀྱི་ནམ་མཁའི་ཆ་རྐྱེན་བྲིས།"

msgid ""
"Apply default values for all preferences (except settings).\n"
"Flag: -defaults"
msgstr ""
"དགའ་མོས་ཚང་མའི་ཆེད་དུ་སྔོན་སྒྲིག་རིན་ཐང་འཇུག་སྤྱོད་བྱེད།(སྒྲིག་སྟངས་མ་གཏོགས།)\n"
"Flag: -defaults"

msgid ""
"Apply vintage values for all preferences (except settings).\n"
"Flag: -vintage"
msgstr ""
"དགའ་མོས་ཚང་མའི་ཆེད་དུ་སྔོན་མའི་རིན་ཐང་འཇུག་སྤྱོད་བྱེད།(སྒྲིག་སྟངས་མ་གཏོགས།)\n"
"Flag: -vintage"

msgid "Wind"
msgstr "རླུང"

msgid "Windy"
msgstr "རླུང་པོ་ཚ"

msgid ""
"If set, there will be wind.\n"
"Flags: -wind, -nowind"
msgstr ""
"གལ་ཏེ་སྒྲིག་ན་རླུང་འབྱུང་ངེས།\n"
"Flags: -wind, -nowind"

msgid "Whirl:"
msgstr "འཁྱིལ།"

msgid ""
"The higher this setting, the more the wind will whirl.\n"
"Flag: -whirlfactor"
msgstr ""
"སྒྲིག་སྟངས་འདི་མཐོ་རུ་སོང་ན་རླུང་དེ་མང་དུ་འཁོར་རྒྱུ་རེད།\n"
"Flag: -whirlfactor"

msgid "Timer:"
msgstr "དུས་ཚོད།"

msgid ""
"This setting determines how many seconds pass between  two  gusts of wind.\n"
"Flag: -windtimer"
msgstr ""
"སྒྲིག་སྟངས་འདིས་རླུང་འཚུབ་གཉིས་ཀྱི་བར་ལ་སྐར་ཆ་ག་ཚོད་འགྲོ་གི་ཡོད་མེད་གཏན་འབེབས་བྱེད།\n"
"Flag: -windtimer"

msgid "Now!"
msgstr "ད་ལྟ!"

msgid "Force a gust of wind immediately."
msgstr "མྱུར་དུ་རླུང་འཚུབ་ཅིག་བཙན་ཤེད་ཀྱིས་གཏོང་དགོས།"

msgid "Stars"
msgstr "སྐར་མ།"

msgid ""
"To show or not show stars.\n"
"Flag: -stars  (0 means: no stars)"
msgstr ""
"སྐར་མ་སྟོན་པའམ་མི་སྟོན།\n"
"Flag: -stars  (0 means: no stars)"

msgid "Number:"
msgstr "ཨང་གྲངས:"

msgid ""
"Number of twinkling stars.\n"
"Flag: -stars"
msgstr ""
"འོད་འཚེར་བའི་སྐར་མའི་གྲངས།\n"
"Flag: -stars"

msgid "Moon"
msgstr "ཟླ་བ"

msgid ""
"To show or not show moon.\n"
"Flags: -moon 1, -moon 0"
msgstr ""
"ཟླ་བ་སྟོན་པའམ་མི་སྟོན།\n"
"Flags: -moon 1, -moon 0"

msgid ""
"Speed of moon in pixels/minute.\n"
"Flag: -moonspeed"
msgstr ""
"ཟླ་བའི་མགྱོགས་ཚད་པིག་སེལ་/སྐར་མ་ནང་།\n"
"Flag: -moonspeed"

msgid ""
"Relative size of the moon.\n"
"Flag: -moonsize"
msgstr ""
"ཟླ་བའི་འབྲེལ་བའི་ཆེ་ཆུང་།\n"
"Flag: -moonsize"

msgid "Halo"
msgstr "ཧ་ལོ།"

msgid ""
"To show or not to show halo around moon.\n"
"Flags: -halo 1, -halo 0"
msgstr ""
"ཟླ་བའི་མཐའ་འཁོར་དུ་འོད་མདངས་སྟོན་དགོས་སམ་མི་སྟོན་དགོས།\n"
"Flags: -halo 1, -halo 0"

msgid "Bright:"
msgstr "འོད་མདངས:"

msgid ""
"Brightness of moon's halo.\n"
"Flag: -halobrightness"
msgstr ""
"ཟླ་བའི་འོད་ཀྱི་འོད་མདངས།\n"
"Flag: -halobrightness"

msgid "Meteors"
msgstr "སྐར་མདའ་།"

msgid ""
"To show or not to show meteors.\n"
"Flags: -meteors, -nometeors"
msgstr ""
"སྐར་མདའ་སྟོན་དགོས་སམ་མི་སྟོན་དགོས།\n"
"Flags: -meteors, -nometeors"

msgid "Aurora"
msgstr "ཨོ་རོ་ར།"

msgid ""
"To show or not show aurora.\n"
"Note: the aurora is best viewed using a dark background.\n"
"Flags: -aurora 1, -aurora 0"
msgstr ""
"འོད་མདངས་སྟོན་པའམ་མི་སྟོན་པ།\n"
"དྲན་ཐོ། འོད་མདངས་དེ་རྒྱབ་ལྗོངས་ནག་པོ་སྤྱད་ནས་བལྟ་ན་ཡག་ཤོས་རེད།\n"
"Flags: -aurora 1, -aurora 0"

msgid "Width:"
msgstr "ཞེང:"

msgid ""
"Width of aurora in percentage of screen width.\n"
"Flag: -aurorawidth"
msgstr ""
"འོད་ཀྱི་རྒྱ་ཁྱོན་དེ་གློག་བརྙན་གྱི་རྒྱ་ཁྱོན་གྱི་བརྒྱ་ཆའི་ནང་།\n"
"Flag: -aurorawidth"

msgid "Height:"
msgstr "ལུས་པོའི་མཐོ་ཚད:"

msgid ""
"Vertical size of aurora.\n"
"Flag: -auroraheight"
msgstr ""
"ཉི་མའི་ལངས་པའི་ཚད།\n"
"Flag: -auroraheight"

msgid ""
"Animation speed of aurora: real: 10, for a more dramatic effect choose: 100\n"
"Flag: -auroraspeed"
msgstr ""
"ཉི་མའི་འོད་ཀྱི་བསྒུལ་བདེའི་མགྱོགས་ཚད། དངོས་པོ། 10 འཁྲབ་སྟོན་གྱི་ནུས་པ་ཆེ་རུ་གཏོང་ཆེད་འདེམས། 100\n"
"Flag: -auroraspeed"

msgid ""
"Brightness of aurora.\n"
"Flags: -aurorabrightness"
msgstr ""
"ཉི་མའི་འོད་མདངས།\n"
"Flags: -aurorabrightness"

msgid "Frequency:"
msgstr "ཡང་འཁོར་བསྐྱར་འཁོར:"

msgid ""
"Frequency of meteors to appear.\n"
"Flags: -meteorfrequency"
msgstr ""
"སྐར་མདའ་འབྱུང་བའི་བསྐྱར་འབྱུང་།\n"
"Flags: -meteorfrequency"

msgid "Vertical:"
msgstr "གྱེན་ཕྱོགས:"

msgid ""
"Baseline height of aurora, in percentage of screen height.\n"
"Flag: -aurorabase"
msgstr ""
"ཉི་འོད་ཀྱི་གཞི་གྲངས་མཐོ་ཚད། གློག་བརྙན་གྱི་མཐོ་ཚད་ཀྱི་བརྒྱ་ཆ།\n"
"Flag: -aurorabase"

msgid "Color"
msgstr "ཁ་དོག"

msgid ""
"Choose between yellow-ish and white-ish moon.\n"
"Flag: -mooncolor [0,1]"
msgstr ""
"ཟླ་བ་སེར་པོ་དང་དཀར་པོ་གཉིས་ཀྱི་བར་ལ་འདེམས།\n"
"Flag: -mooncolor [0,1]"

msgid ""
"Size of stars.\n"
"Flag: -starsize"
msgstr ""
"སྐར་མའི་ཚད་གཞི།\n"
"Flag: -starsize"

msgid "Horizontal:"
msgstr "འཕྲེད:"

msgid ""
"Horizontal place of aurora\n"
"Flags: -aurorax"
msgstr ""
"འོད་ཀྱི་འཕྲེད་ཐིག་ས་ཆ།\n"
"Flags: -aurorax"

msgid "Position:"
msgstr "གནས:"

msgid "X-position:"
msgstr "X-གནས་སྟངས།"

msgid "Y-position"
msgstr "Y-གནས་ཚུལ།"

msgid ""
"Horizontal position of moon if speed equals 0.\n"
"Flag: -moonx"
msgstr ""
"གལ་ཏེ་མགྱོགས་ཚད་0དང་འདྲ་ན་ཟླ་བའི་ཐད་སྙོམས་གནས་བབ།\n"
"Flag: -moonx"

msgid ""
"Vertical position of moon if speed equals 0.\n"
"Flag: -moony"
msgstr ""
"གལ་ཏེ་མགྱོགས་ཚད་0དང་འདྲ་ན་ཟླ་བའི་ལངས་པའི་གནས་བབ།\n"
"Flag: -moony"

msgid "Celestials"
msgstr "གནམ་གཤིས་རིགས།"

msgid "Birds settings"
msgstr "བྱིའུ་སྒྲིག་སྟངས།"

msgid "Show birds"
msgstr "བྱིའུ་སྟོན།"

msgid ""
"If set: show birds.\n"
"Flags: -showbirds 1, -showbirds 0"
msgstr ""
"གལ་ཏེ་སྒྲིག་ཚེ། བྱིའུ་སྟོན།\n"
"Flags: -showbirds 1, -showbirds 0"

msgid "Birds only"
msgstr "བྱིའུ་རྐྱང་རྐྱང་།"

msgid ""
"If set: show no Santa, snow or scenery.\n"
"Flags: -birdsonly 0, -birdsony 1"
msgstr ""
"གལ་ཏེ་སྒྲིག་ཡོད་ན། སན་ཊ་དང་གངས་ཀྱི་ཡུལ་ལྗོངས། \n"
"Flags: -birdsonly 0, -birdsony 1"

msgid "Preferred distance:"
msgstr "འདོད་པའི་ཐག་རིང་།"

msgid ""
"Preferred distance from other birds.\n"
"Flag: -prefdistance"
msgstr ""
"བྱིའུ་གཞན་དང་བར་ཐག་འདོད་པ་ཡོད།\n"
"Flag: -prefdistance"

msgid "Restart"
msgstr "བསྐྱར་དུ་འགོ་འཛུགས།"

msgid "Restart birds."
msgstr "བྱིའུ་བསྐྱར་དུ་འགོ་བཙུགས།"

msgid "Viewing distance:"
msgstr "ལྟ་བའི་བར་ཐག་ནི།"

msgid ""
"Viewing distance.\n"
"NOTE: Santa has no knowledge of viewing distance, so when birds are "
"following Santa, the relative positions of Santa and birds will be "
"temporarely out of sync when you change the viewing distance. This is only "
"noticeable when the birds are following Santa.\n"
"Flag: -viewingdistance"
msgstr ""
"བལྟ་བའི་ཐག་རིང་།\n"
"དྲན་ཐོ། སན་ཊ་ལ་མཐོང་བའི་ཐག་རིང་ཚད་ཀྱི་ཤེས་བྱ་མེད་པས་བྱིའུ་རྣམས་སན་ཊའི་རྗེས་སུ་འབྲང་སྐབས་ཁྱེད་ཀྱིས་བལྟ་"
"བའི་ཐག་རིང་ཚད་བསྒྱུར་སྐབས་སན་ཊ་དང་བྱིའུ་གཉིས་ཀྱི་འབྲེལ་ཡོད་གནས་བབ་གནས་སྐབས་དུས་མཉམ་མིན་པར་འགྱུར། "
"འདི་བྱིའུ་རྣམས་སན་ཊའི་རྗེས་སུ་འབྲང་སྐབས་རྐྱངམ་གཅིག་མངོན་ཐུབ།\n"
"Flag: -viewingdistance"

msgid "Focus to attraction point:"
msgstr "ཡིད་འཕྲོག་ས་ཚིགས་ལ་དམིགས་པ།"

msgid ""
"Tendency to concentrate on the attraction point.\n"
"Flag: -focuscentre"
msgstr ""
"འདྲེན་ཤུགས་ས་ཚིགས་ལ་དོ་སྣང་བྱེད་པའི་རང་གཤིས།\n"
"Flag: -focuscentre"

msgid ""
"Desired number of birds. If zero, no birds are shown.\n"
"Flag: -nbirds"
msgstr ""
"འདོད་པའི་བྱིའུ་གྲངས་འབོར། གལ་ཏེ་ཀླད་ཀོར་ཡིན་ན་བྱིའུ་གཅིག་ཀྱང་སྟོན་མི་ཐུབ།\n"
"Flag: -nbirds"

msgid "# Birds:"
msgstr "# བྱིའུ།"

msgid ""
"Number of nearest neighbours the birds should look at.\n"
"Flag: -neighbours"
msgstr ""
"བྱིའུ་ཡིས་ཁྱིམ་མཚེས་ཉེ་ཤོས་ལ་ལྟ་དགོས་པའི་གྲངས་འབོར།\n"
"Flag: -neighbours"

msgid "Neighbours:"
msgstr "ཁྱིམ་མཚེས།"

msgid ""
"Give the birds a fancy color.\n"
"Flag: -birdscolor"
msgstr ""
"བྱིའུ་ལ་ཚོན་མདོག་མཛེས་པོ་ཞིག་སྤྲོད་དགོས།\n"
"Flag: -birdscolor"

msgid "Bird color"
msgstr "བྱིའུ་ཡི་ཁ་དོག།"

msgid "Anarchy:"
msgstr "གཞུང་མེད་རིང་ལུགས།"

msgid ""
"Anarchy level: the higher, the more anarchy.\n"
"Flag: -anarchy"
msgstr ""
"གཞུང་མེད་རིང་ལུགས་ཀྱི་གནས་ཚད། མཐོ་རུ་སོང་ན་གཞུང་མེད་རིང་ལུགས་མང་བ་ཡོད།\n"
"Flag: -anarchy"

msgid "Distance weight:"
msgstr "ཐག་རིང་གི་ལྗིད་ཚད།"

msgid ""
"Tendency to keep desired distance to neighbours.\n"
"Flag: -disweight"
msgstr ""
"ཁྱིམ་མཚེས་ལ་འདོད་པའི་བར་ཐག་ཉར་བའི་རང་གཤིས།\n"
"Flag: -disweight"

msgid "Adjust speed to neighbours:"
msgstr "ཁྱིམ་མཚེས་ལ་མགྱོགས་ཚད་སྙོམ་སྒྲིག་བྱེད་པ།"

msgid ""
"Tendency to adjust speed to neighbours.\n"
"Flag: -followneighbours"
msgstr ""
"ཁྱིམ་མཚེས་ལ་མགྱོགས་ཚད་སྙོམ་སྒྲིག་བྱེད་པའི་རང་གཤིས།\n"
"Flag: -followneighbours"

msgid ""
"Speed of birds in arbitrary units.\n"
"Flag: -birdsspeed"
msgstr ""
"བྱིའུ་ཡི་མགྱོགས་ཚད་གང་འདོད་ཀྱི་ཚད་གཞི་ནང་།\n"
"Flag: -birdsspeed"

msgid "Drawing scale:"
msgstr "རི་མོའི་ཚད་གཞི།"

msgid ""
"Influence the size of the birds.\n"
"Flag: -birdsscale\n"
msgstr ""
"བྱིའུ་ཡི་ཆེ་ཆུང་ལ་ཤུགས་རྐྱེན་ཐེབས་ཡོད།\n"
"Flag: -birdsscale\n"

msgid ""
"Show \n"
"attr point"
msgstr "ཡིད་འཕྲོག་པ་སྟོན་པ།"

msgid ""
"Show the point where the birds want to go.\n"
"Flags: -showattr 0, -showattr 1"
msgstr ""
"བྱིའུ་རྣམས་འགྲོ་འདོད་པའི་ས་ཚིགས་སྟོན།\n"
"Flags: -showattr 0, -showattr 1"

msgid ""
"Follow \n"
"Santa"
msgstr "སན་ཊ་ལ་རྗེས་འདེད་བྱེད།"

msgid ""
"Birds are attracted by an attraction point. Here you can choose to follow "
"Santa.\n"
"Flags: -followsanta 0, -followsanta 1"
msgstr ""
"བྱིའུ་རྣམས་ཡིད་འཕྲོག་ས་ཚིགས་ཤིག་གིས་ཡིད་འཕྲོག་པ་ཞིག་ཡིན། འདིར་ཁྱེད་ཀྱིས་སན་ཊ་ལ་རྗེས་འདེད་བྱེད་ཐུབ།\n"
"Flags: -followsanta 0, -followsanta 1"

msgid ""
"Percentage of screen to be used for the attraction point.\n"
"Flag: -attrspace"
msgstr ""
"འཐེན་ཤུགས་ས་ཚིགས་ལ་སྤྱོད་རྒྱུའི་བརྙན་ཤེལ་གྱི་བརྒྱ་ཆ།\n"
"Flag: -attrspace"

msgid "Attraction point range"
msgstr "ཡིད་འཕྲོག་ས་ཚིགས་ཁྱབ་ཁོངས།"

msgid "Actual mean distance from neighbours."
msgstr "ཁྱིམ་མཚེས་བར་གྱི་ཆ་སྙོམས་བར་ཐག་དངོས་མ།"

msgid "Distance used to get the desired number of neighbours."
msgstr "ཁྱིམ་མཚེས་འདོད་པའི་གྲངས་འབོར་ཐོབ་པའི་བར་ཐག་བེད་སྤྱོད་བྱེད།"

msgid "Birds"
msgstr "བྱིའུ།"

msgid "version"
msgstr "པར་གཞི"

msgid "Transparency "
msgstr "ཕྱི་གསལ་ནང་གསལ། "

msgid ""
"Transparency of painted items:\n"
"0: no transparency.\n"
"100: fully transparent, you will see nothing!\n"
"Flag: -transparency"
msgstr ""
"ཚོན་བཏང་བའི་རྣམ་གྲངས་ཀྱི་དྭངས་གསལ།:\n"
"0: དྭངས་གསལ་མེད།\n"
"100: ཆ་ཚང་དྭངས་གསལ་ཡིན་ན་ཁྱོད་ཀྱིས་གང་ཡང་མཐོང་མི་ཐུབ།\n"
"Flag: -transparency"

msgid "Lift snow on bottom"
msgstr "འོག་ནས་གངས་འདེགས་པ།"

msgid ""
"Use this if snow falls below the bottom of your screen, or  fallen snow "
"hides something that should not be hidden.\n"
"Flag: -offsets"
msgstr ""
"གལ་ཏེ་ཁ་བ་ཁྱེད་ཀྱི་གློག་བརྙན་གྱི་གཤམ་གྱི་འོག་ལ་འབབ་ན་ཡང་ན་གངས་ཀྱིས་སྦས་མི་དགོས་པའི་དངོས་པོ་སྦས་ན་"
"འདི་བེད་སྤྱོད་བྱོས།\n"
"Flag: -offsets"

msgid "Lift snow on windows"
msgstr "སྒེའུ་ཁུང་སྟེང་གངས་འདེགས་པ།"

msgid ""
"Use this if no snow collects on your windows, or if snow  collects separated "
"from your windows. \n"
"Some basic window managers need this setting (e.g. TWM  needs in general a "
"value of 25 .. 28).\n"
"Flag: -offsety"
msgstr ""
"གལ་ཏེ་ཁྱེད་ཀྱི་སྒེའུ་ཁུང་སྟེང་ལ་གང་ཡང་མ་བསྡུ་བའམ་ཡང་ན་ཁྱེད་ཀྱི་སྒེའུ་ཁུང་ནས་ཁ་བྲལ་ནས་གངས་ཀྱིས་བསྡུ་རུབ་"
"བྱེད་ཀྱི་ཡོད་ན། \n"
"གཞི་རྩའི་སྒེའུ་ཁུང་འཛིན་སྐྱོང་པ་ཁ་ཤས་ལ་སྒྲིག་སྟངས་འདི་དགོས། (དཔེར་ན། TWM ལ་སྤྱིར་བཏང་དུ་རིན་ཐང་ "
"25 .. 28 དགོས།)\n"
"Flag: -offsety"

msgid "Cpu factor"
msgstr "CPU ཆ་རྐྱེན།"

msgid ""
"The higher, the smoother xsnow will run, but will also use  more cpu power.\n"
"Flag: -cpuload"
msgstr ""
"མཐོ་རུ་འགྲོ་ཚེ། xsnow འཇམ་པོ་འགྲོ་སྲིད། འོན་ཀྱང་། ད་དུང་སི་པི་ཡུ་ནུས་ཤུགས་མང་བ་བེད་སྤྱོད་བྱེད།\n"
"Flag: -cpuload"

msgid "Scale"
msgstr "ཤུན་སྐོགས་སྲབ་མོ"

msgid ""
"Overall drawing scale.\n"
"Flag: -scale"
msgstr ""
"སྤྱིའི་རི་མོའི་ཚད་གཞི།\n"
"Flag: -scale"

msgid "Ignore top windows"
msgstr "སྟེང་གི་སྒེའུ་ཁུང་ལ་སྣང་མེད་བྱེད་པ།"

msgid ""
"Windows closer to the top  than the number in this widget will not collect "
"snow.\n"
"\n"
"In some cases, there are invisible windows near the top of the screen, which "
"are handled by xsnow as normal windows: snow is collected upon them. By "
"entering a suitable number here, this undesired behaviour can be avoided.\n"
"Flag: -ignoretop\n"
"\n"
msgstr ""
"ཝི་ཇེཊ་འདིའི་ནང་གི་ཨང་གྲངས་ལས་མགོ་ལ་ཉེ་བའི་སྒེའུ་ཁུང་གིས་གངས་ཀྱི་སྒེའུ་ཁུང་བསྡུ་རུབ་བྱེད་ཀྱི་མེད།\n"
"\n"
"གནས་སྟངས་འགའ་ཤས་ནང་གསལ་གཞིའི་མགོ་ལ་མཐོང་མི་ཐུབ་པའི་སྒེའུ་ཁུང་ཡོད། འདིར་འོས་འཚམ་གྱི་ཨང་གྲངས་བླུགས་"
"ན་མི་འདོད་པའི་བྱ་སྤྱོད་འདི་སྔོན་འགོག་བྱེད་ཐུབ།\n"
"Flag: -ignoretop\n"
"\n"

msgid "Ignore bottom windows"
msgstr "འོག་གི་སྒེའུ་ཁུང་སྣང་མེད་དུ་གཏོང་བ།"

msgid ""
"Windows closer to the  bottom than the number in this widget will not "
"collect snow.\n"
"\n"
"In some cases, there are invisible windows near the bottom  of  the screen, "
"which are handled by xsnow as normal windows: snow is collected upon them. "
"By entering a suitable  number here, this undesired behaviour can be "
"avoided.\n"
"Flag: -ignorebottom"
msgstr ""
"ཝི་ཇེཊ་འདིའི་ནང་གི་ཨང་གྲངས་ལས་མཇུག་ལ་ཉེ་བའི་སྒེའུ་ཁུང་གིས་གངས་བསྡུ་རུབ་བྱེད་ཀྱི་མེད།\n"
"\n"
"གནས་སྟངས་འགའ་ཤས་ནང་གསལ་གཞིའི་མཇུག་ཉེ་འགྲམ་དུ་མཐོང་མི་ཐུབ་པའི་སྒེའུ་ཁུང་ཡོད། འདིར་འོས་འཚམ་གྱི་ཨང་"
"གྲངས་བླུགས་ན་མི་འདོད་པའི་བྱ་སྤྱོད་འདི་སྔོན་འགོག་བྱེད་ཐུབ།\n"
"Flag: -ignorebottom"

msgid ""
"Menu\n"
"colors"
msgstr ""
"རེའུ་མིག་\n"
"ཚོས་གཞི།"

msgid ""
"Toggle between xsnow's own menu colors and standard menu colors.\n"
"Activated: use xsnow colors.\n"
"Deactivated: use default colors.\n"
"Flags: -theme 1, -theme 0"
msgstr ""
"xsnow ཡི་རང་ཉིད་ཀྱི་དཀར་ཆག་ཚོས་གཞི་དང་ཚད་ལྡན་དཀར་ཆག་ཚོས་གཞིའི་བར་ལ་བརྗེ་སྒྱུར་བྱེད།\n"
"ཤུགས་ལྡན་བཟོས་: xsnow ཚོས་གཞི་བེད་སྤྱོད་བྱེད།\n"
"ཤུགས་མེད་བཟོས་: སྔོན་སྒྲིག་ཚོས་གཞི་བེད་སྤྱོད་བྱེད།\n"
"Flags: -theme 1, -theme 0"

msgid ""
"On all\n"
"workspaces"
msgstr "ལས་ཀའི་ས་ཁོངས་ཚང་མའི་སྟེང་།"

msgid ""
"Use all workspaces to snow in.\n"
"NOTE: this doesn't work properly in enlightenment.\n"
"Flags: -allworkspaces 1, -allworkspaces 0"
msgstr ""
"ལས་ཀའི་ས་ཁོངས་ཚང་མ་བེད་སྤྱད་ནས་གངས་ཀྱི་ནང་དུ་འཇུག་དགོས།\n"
"དྲན་ཐོ། འདི་འོད་གསལ་ནང་ལེགས་པར་ལས་ཀ་བྱེད་ཀྱི་མེད།\n"
"Flags: -allworkspaces 1, -allworkspaces 0"

msgid ""
"Below\n"
"windows"
msgstr ""
"གཤམ་གྱི་\n"
"སྒེའུ་ཁུང་།"

msgid ""
"When activated, it will be snowing below your windows, else  it will be "
"snowing upon you windows too.\n"
"On some desktop environments, when snowing above your  windows you will not "
"be able to click on any window.\n"
"Therefore, you will be asked to click a button, to be sure that  things are "
"OK.\n"
"Flag: -above"
msgstr ""
"ཁྱེད་ཀྱི་སྒེའུ་ཁུང་གི་འོག་ལ་གངས་ཀྱི་འབབ་རྒྱུ་དང་། དེ་མིན་ན་ཁྱེད་ཀྱི་སྒེའུ་ཁུང་གི་སྟེང་ལ་ཡང་གངས་ཀྱི་འབབ་རྒྱུ་"
"རེད། འགྲིག \n"
"Flag: -above"

msgid ""
"Click to\n"
"confirm"
msgstr "གཏན་འཁེལ་བྱེད་པར་སྣུན།"

msgid "To make sure you can click."
msgstr "ཁྱོད་ཀྱིས་སྣུན་ཐུབ་པར་ངེས་གཏན་བཟོ་ཆེད།"

msgid ""
"If you have more than one monitor, choose where you want snow falling. "
"Choose 'all monitors' if you want snow in all monitors.\n"
"NOTE: when changing monitor, xsnow will restart.\n"
"Flag: -screen"
msgstr ""
"གལ་ཏེ་ཁྱེད་ལ་འཆར་ཤེལ་གཅིག་ལས་མང་བ་ཡོད་ན། ཁྱེད་ལ་གང་དུ་གངས་ཀྱིས་འབབ་དགོས་མིན་འདེམས། གལ་ཏེ་ཁྱེད་"
"ལ་འཆར་ཤེལ་ཚང་མའི་ནང་གངས་ཀྱིས་ཁེངས་དགོས་ན། 'འཆར་ཤེལ་ཚང་མ' འདེམས།\n"
"དྲན་ཐོ། འཆར་ཤེལ་བརྗེ་སྒྱུར་བྱེད་སྐབས། xsnow བསྐྱར་དུ་འགོ་འཛུགས།\n"
"Flag: -screen"

msgid "monitor 1"
msgstr "ལྟ་རྟོག ༡"

msgid ""
"Create\n"
"outline"
msgstr "བཀོད་རིས་གསར་བཟོ།"

msgid ""
"To draw an outline around the snow window.\n"
"Flag: -outline 1/0"
msgstr ""
"གངས་ཀྱི་སྒེའུ་ཁུང་གི་མཐའ་འཁོར་དུ་ཕྱི་ཐིག་འབྲི་དགོས།\n"
"Flag: -outline 1/0"

msgid ""
"Use \n"
"screenshots"
msgstr "ཡི་འཆར་ཤེལ་བེད་སྤྱོད་བྱེད།"

msgid "Use screenshots for the location of windows. Experimental."
msgstr "སྒེའུ་ཁུང་གི་གནས་ཡུལ་ལ་གློག་བརྙན་གྱི་པར་རིས་བེད་སྤྱོད་བྱེད། ཚོད་ལྟ།"

msgid ""
"  \n"
"  "
msgstr ""
"  \n"
"  "

msgid ""
"Choose here the picture you want as background when  xscreensaver is "
"active.\n"
"Flag: -bg"
msgstr ""
"xscreensaver ཤུགས་ལྡན་ཡིན་པའི་སྐབས་འདིར་ཁྱེད་རང་ལ་རྒྱབ་ལྗོངས་དགོས་པའི་པར་རིས་འདེམས།\n"
"Flag: -bg"

msgid "Choose background"
msgstr "རྒྱབ་ལྗོངས་འདེམས།"

msgid ""
"Activate xscreensaver.\n"
"Click and don't touch mouse and keyboard for a few seconds..."
msgstr ""
"xscreensaver ཤུགས་སྣོན་རྒྱོབ། \n"
"སྣུན་ནས་སྐར་ཆ་འགའ་ཤས་རིང་བྱི་རིལ་དང་མཐེབ་གཞོང་ལ་མ་འཆང་།"

msgid ""
"Settings for Xscreensaver. You can choose a background, and choose to use it "
"or not.\n"
"Make sure you add a line like\n"
"xsnow -root\n"
"after the line 'programs:' in the file ~/.xscreensaver and you run "
"xscreensaver-demo to choose for xsnow.\n"
"To activate xscreensaver on the command line:\n"
"xscreensaver-command  -activate\n"
"See also the man page:\n"
"man xsnow"
msgstr ""
"Xscreensaver ཡི་སྒྲིག་སྟངས། ཁྱོད་ཀྱིས་རྒྱབ་ལྗོངས་འདེམས་ཆོག དེ་བེད་སྤྱོད་གཏོང་མིན་འདེམས་ཆོག \n"
"ཡིག་ཆ་ ~/.xscreensaver ནང་ 'programs:' ཡི་རྗེས་སུ་\n"
"xsnow -root\n"
"ལྟ་བུའི་གྲལ་ཐིག་ཅིག་ཁ་སྣོན་བྱེད་དགོས། xsnow.\n"
"བཀའ་ཚིག་གྲལ་ཐིག་སྟེང་xscreensaverཤུགས་ལྡན་བཟོ་བར།:\n"
"xscreensaver-བཀའ་ཚིག་ -activate\n"
"མན་ཤོག་ངོས་ལ་ཡང་གཟིགས།\n"
"man xsnow."

msgid "Xscreensaver: "
msgstr "Xscreensaver: "

msgid "Black"
msgstr "ནག་པོ"

msgid ""
"When activated, the background will be black.\n"
"Flag: -bg  (this button will be automatically desactivated when -bg is given)"
msgstr ""
"ཤུགས་ལྡན་བཟོས་ཚེ་རྒྱབ་ལྗོངས་ནག་པོ་ཆགས་རྒྱུ་རེད།\n"
"Flag: -bg  (this button will be automatically desactivated when -bg is given)"

