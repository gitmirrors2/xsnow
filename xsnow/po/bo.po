#~ msgid "Warning: '-auroraleft' is deprecated, using '-aurorax 25' .\n"
#~ msgstr "ཉེན་བརྡ། '-auroraleft' བེད་སྤྱོད་མེད་པར་བཟོས་ཡོད། '-aurorax 25' .\n"

#, c-format
#~ msgid "Warning: '-auroramiddle' is deprecated, using '-aurorax 50' .\n"
#~ msgstr "ཉེན་བརྡ། '-ཨོ་རོ་རཱ་མིཌལ་' བེད་སྤྱོད་མེད་པར་བཟོས་ཡོད། '-ཨོ་རོ་རེགསི་ ༥༠' .\n"

