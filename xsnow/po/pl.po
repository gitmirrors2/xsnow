msgid "en"
msgstr "en"

msgid "it"
msgstr "to"

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"System jest zbyt zajęty, sugeruj zmniejszenie „obciążenia procesora” w "
