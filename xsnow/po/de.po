" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
msgstr ""
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"

msgid "en"
msgstr "en"

msgid "it"
msgstr "es"

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"Das System ist zu beschäftigt. Schlagen Sie vor, die „CPU-Last“ in den "
"„Einstellungen“ zu verringern.\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr ""
" oder schauen Sie sich „Schnee“ an: „Intensität“, „Maximale "
"Flockenanzahl“, ... \n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " oder geben Sie eine kleinere Anzahl von Vögeln in „Vögeln“ an.\n"

