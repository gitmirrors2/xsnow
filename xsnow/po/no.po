msgstr ""
"Systemet er for opptatt, foreslår å senke 'cpu-belastning' i "
"'innstillinger'\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr " eller ta en titt på 'snø': 'Intensitet', 'Maks antall flak', ... \n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " eller spesifiser et mindre antall fugler i 'fugler'\n"

