msgstr ""
"Ísbjörn.\n"
"Flags: -treetype 7 or: -treetype all"

msgid "# Items:"
msgstr "# Hlutir:"

msgid ""
"Desired number of scenery items.\n"
"Flag: -trees"
msgstr ""
"Æskilegur fjöldi landslagsvara.\n"
"Flag: -trees"

msgid "% Window fill:"
msgstr "% gluggafylling:"

msgid ""
"Bottom percentage of screen available for scenery.\n"
"Flag: -treefill"
msgstr ""
"Neðsta hlutfall skjásins tiltækt fyrir landslag.\n"
"Flag: -treefill"

msgid "Allow overlap"
msgstr "Leyfa skörun"

msgid ""
"To allow overlap or not when placing scenery.\n"
"Flags: -treeoverlap, -notreeoverlap"
msgstr ""
"Til að leyfa skörun eða ekki þegar landslag er sett.\n"
"Flags: -treeoverlap, -notreeoverlap"

msgid ""
"Scale of scenery.\n"
"Flag: sceneryscale <n>"
msgstr ""
"Umfang landslags.\n"
"Flag: sceneryscale <n>"

msgid "Scenery"
msgstr "Landslag"

msgid "Compose here your favorite celestial conditions"
msgstr "Settu saman uppáhalds himnesku aðstæðurnar þínar"

msgid ""
"Apply default values for all preferences (except settings).\n"
"Flag: -defaults"
msgstr ""
"Notaðu sjálfgefin gildi fyrir allar stillingar (nema stillingar).\n"
"Flag: -defaults"

msgid ""
"Apply vintage values for all preferences (except settings).\n"
"Flag: -vintage"
msgstr ""
"Notaðu árgangsgildi fyrir allar óskir (nema stillingar).\n"
"Flag: -vintage"

msgid "Wind"
msgstr "Vindur"

msgid "Windy"
msgstr "Vindasamt"

msgid ""
"If set, there will be wind.\n"
"Flags: -wind, -nowind"
msgstr ""
"Ef það er stillt verður vindur.\n"
"Flags: -wind, -nowind"

msgid "Whirl:"
msgstr "Sveifla:"

msgid ""
"The higher this setting, the more the wind will whirl.\n"
"Flag: -whirlfactor"
msgstr ""
"Því hærra sem þessi stilling, því meira mun vindurinn þyrlast.\n"
"Flag: -whirlfactor"

msgid "Timer:"
msgstr "Tímamælir:"

msgid ""
"This setting determines how many seconds pass between  two  gusts of wind.\n"
"Flag: -windtimer"
msgstr ""
"Þessi stilling ákvarðar hversu margar sekúndur líða á milli tveggja "
"vindhviða.\n"
"Flag: -windtimer"

msgid "Now!"
msgstr "Nú!"

msgid "Force a gust of wind immediately."
msgstr "Þrýstu vindhviðu strax."

msgid "Stars"
msgstr "Stjörnur"

msgid ""
"To show or not show stars.\n"
"Flag: -stars  (0 means: no stars)"
msgstr ""
"Til að sýna eða ekki sýna stjörnur.\n"
"Flag: -stars  (0 means: no stars)"

msgid "Number:"
msgstr "Númer:"

msgid ""
"Number of twinkling stars.\n"
"Flag: -stars"
msgstr ""
"Fjöldi blikkandi stjarna.\n"
"Flag: -stars"

msgid "Moon"
msgstr "Tungl"

msgid ""
"To show or not show moon.\n"
"Flags: -moon 1, -moon 0"
msgstr ""
"Til að sýna eða ekki sýna tungl.\n"
"Flags: -moon 1, -moon 0"

msgid ""
"Speed of moon in pixels/minute.\n"
"Flag: -moonspeed"
msgstr ""
"Hraði tunglsins í punktum/mínútu.\n"
"Flag: -moonspeed"

msgid ""
"Relative size of the moon.\n"
"Flag: -moonsize"
msgstr ""
"Hlutfallsleg stærð tunglsins.\n"
"Flag: -moonsize"

msgid "Halo"
msgstr "Halló"

msgid ""
"To show or not to show halo around moon.\n"
"Flags: -halo 1, -halo 0"
msgstr ""
"Að sýna eða ekki að sýna geislabaug í kringum tunglið.\n"
"Flags: -halo 1, -halo 0"

msgid "Bright:"
msgstr "Björt:"

msgid ""
"Brightness of moon's halo.\n"
"Flag: -halobrightness"
msgstr ""
"Birta geislabaugs tunglsins.\n"
"Flag: -halobrightness"

msgid "Meteors"
msgstr "Loftsteinar"

msgid ""
"To show or not to show meteors.\n"
"Flags: -meteors, -nometeors"
msgstr ""
"Að sýna eða ekki sýna loftsteina.\n"
"Flags: -meteors, -nometeors"

msgid "Aurora"
msgstr "Aurora"

msgid ""
"To show or not show aurora.\n"
"Note: the aurora is best viewed using a dark background.\n"
"Flags: -aurora 1, -aurora 0"
msgstr ""
"Að sýna eða ekki sýna norðurljós.\n"
"Athugið: best er að skoða norðurljósið með dökkum bakgrunni.\n"
"Flags: -aurora 1, -aurora 0"

msgid "Width:"
msgstr "Breidd:"

msgid ""
"Width of aurora in percentage of screen width.\n"
"Flag: -aurorawidth"
msgstr ""
"Breidd norðurljósa í prósentu af skjábreidd.\n"
"Flag: -aurorawidth"

msgid "Height:"
msgstr "Hæð:"

msgid ""
"Vertical size of aurora.\n"
"Flag: -auroraheight"
msgstr ""
"Lóðrétt stærð norðurljósa.\n"
"Flag: -auroraheight"

msgid ""
"Animation speed of aurora: real: 10, for a more dramatic effect choose: 100\n"
"Flag: -auroraspeed"
msgstr ""
"Hreyfihraði norðurljósa: raunverulegur: 10, fyrir dramatískari áhrif veldu: "
"100\n"
"Flag: -auroraspeed"

msgid ""
"Brightness of aurora.\n"
"Flags: -aurorabrightness"
msgstr ""
"Birtustig norðurljósa.\n"
"Flags: -aurorabrightness"

msgid "Frequency:"
msgstr "Tíðni:"

msgid ""
"Frequency of meteors to appear.\n"
"Flags: -meteorfrequency"
msgstr ""
"Tíðni loftsteina sem birtast.\n"
"Flags: -meteorfrequency"

msgid "Vertical:"
msgstr "Lóðrétt:"

msgid ""
"Baseline height of aurora, in percentage of screen height.\n"
"Flag: -aurorabase"
msgstr ""
"Grunnhæð norðurljósa, í prósentu af skjáhæð.\n"
"Flag: -aurorabase"

msgid "Color"
msgstr "Litur"

msgid ""
"Choose between yellow-ish and white-ish moon.\n"
"Flag: -mooncolor [0,1]"
msgstr ""
"Veldu á milli gulleitt og hvítleitt tungl.\n"
"Flag: -mooncolor [0,1]"

msgid ""
"Size of stars.\n"
"Flag: -starsize"
msgstr ""
"Stærð stjarna.\n"
"Flag: -starsize"

msgid "Horizontal:"
msgstr "Lárétt:"

msgid ""
"Horizontal place of aurora\n"
"Flags: -aurorax"
msgstr ""
"Láréttur staður norðurljósa\n"
"Flags: -aurorax"

msgid "Position:"
msgstr "Staða:"

msgid "X-position:"
msgstr "X-staða:"

msgid "Y-position"
msgstr "Y-staða"

msgid ""
"Horizontal position of moon if speed equals 0.\n"
"Flag: -moonx"
msgstr ""
"Lárétt staða tungls ef hraði er 0.\n"
"Flag: -moonx"

msgid ""
"Vertical position of moon if speed equals 0.\n"
"Flag: -moony"
msgstr ""
"Lóðrétt staða tungls ef hraði er jafn 0.\n"
"Flag: -moony"

msgid "Celestials"
msgstr "Himneskur"

msgid "Birds settings"
msgstr "Stillingar fugla"

msgid "Show birds"
msgstr "Sýndu fugla"

msgid ""
"If set: show birds.\n"
"Flags: -showbirds 1, -showbirds 0"
msgstr ""
"Ef stillt: sýna fugla.\n"
"Flags: -showbirds 1, -showbirds 0"

msgid "Birds only"
msgstr "Aðeins fuglar"

msgid ""
"If set: show no Santa, snow or scenery.\n"
"Flags: -birdsonly 0, -birdsony 1"
msgstr ""
"Ef stillt er: sýndu engan Jólasvein, snjó eða landslag.\n"
"Flags: -birdsonly 0, -birdsony 1"

msgid "Preferred distance:"
msgstr "Æskileg fjarlægð:"

msgid ""
"Preferred distance from other birds.\n"
"Flag: -prefdistance"
msgstr ""
"Æskileg fjarlægð frá öðrum fuglum.\n"
"Flag: -prefdistance"

msgid "Restart"
msgstr "Endurræsa"

msgid "Restart birds."
msgstr "Endurræstu fugla."

msgid "Viewing distance:"
msgstr "Skoðunarfjarlægð:"

msgid ""
"Viewing distance.\n"
"NOTE: Santa has no knowledge of viewing distance, so when birds are "
"following Santa, the relative positions of Santa and birds will be "
"temporarely out of sync when you change the viewing distance. This is only "
"noticeable when the birds are following Santa.\n"
"Flag: -viewingdistance"
msgstr ""
"Skoðunarfjarlægð.\n"
" ATHUGIÐ: Jólasveinninn hefur enga þekkingu á útsýnisfjarlægð, þannig að "
"þegar fuglar fylgja Jólasveininum verða hlutfallsleg staða Jólasveinsins og "
"fugla tímabundið úr samstillingu þegar þú breytir útsýnisfjarlægðinni. Þetta "
"er aðeins áberandi þegar fuglarnir fylgja Jólasveininum.\n"
"Flag: -viewingdistance"

msgid "Focus to attraction point:"
msgstr "Einbeittu þér að aðdráttarafl:"

msgid ""
"Tendency to concentrate on the attraction point.\n"
"Flag: -focuscentre"
msgstr ""
"Tilhneiging til að einbeita sér að aðdráttarpunktinum.\n"
"Flag: -focuscentre"

msgid ""
"Desired number of birds. If zero, no birds are shown.\n"
"Flag: -nbirds"
msgstr ""
"Æskilegur fjöldi fugla. Ef núll er enginn fugl sýndur.\n"
"Flag: -nbirds"

msgid "# Birds:"
msgstr "# Fuglar:"

msgid ""
"Number of nearest neighbours the birds should look at.\n"
"Flag: -neighbours"
msgstr ""
"Fjöldi næstu nágranna sem fuglarnir ættu að skoða.\n"
"Flag: -neighbours"

msgid "Neighbours:"
msgstr "Nágrannar:"

msgid ""
"Give the birds a fancy color.\n"
"Flag: -birdscolor"
msgstr ""
"Gefðu fuglunum flottan lit.\n"
"Flag: -birdscolor"

msgid "Bird color"
msgstr "Litur fugla"

msgid "Anarchy:"
msgstr "stjórnleysi:"

msgid ""
"Anarchy level: the higher, the more anarchy.\n"
"Flag: -anarchy"
msgstr ""
"Stjórnleysisstig: því hærra, því meira stjórnleysi.\n"
"Flag: -anarchy"

msgid "Distance weight:"
msgstr "Fjarlægðarþyngd:"

msgid ""
"Tendency to keep desired distance to neighbours.\n"
"Flag: -disweight"
msgstr ""
"Tilhneiging til að halda æskilegri fjarlægð til nágranna.\n"
"Flag: -disweight"

msgid "Adjust speed to neighbours:"
msgstr "Stilltu hraðann að nágrönnum:"

msgid ""
"Tendency to adjust speed to neighbours.\n"
"Flag: -followneighbours"
msgstr ""
"Tilhneiging til að stilla hraða að nágrönnum.\n"
"Flag: -followneighbours"

msgid ""
"Speed of birds in arbitrary units.\n"
"Flag: -birdsspeed"
msgstr ""
"Hraði fugla í handahófskenndum einingum.\n"
"Flag: -birdsspeed"

msgid "Drawing scale:"
msgstr "Teiknikvarði:"

msgid ""
"Influence the size of the birds.\n"
"Flag: -birdsscale\n"
msgstr ""
"Hafa áhrif á stærð fuglanna.\n"
"Flag: -birdsscale\n"

msgid ""
"Show \n"
"attr point"
msgstr ""
"Sýna \n"
"attr punkt"

msgid ""
"Show the point where the birds want to go.\n"
"Flags: -showattr 0, -showattr 1"
msgstr ""
"Sýndu punktinn þar sem fuglarnir vilja fara.\n"
"Flags: -showattr 0, -showattr 1"

msgid ""
"Follow \n"
"Santa"
msgstr ""
"Fylgstu með \n"
" Jólasveininum"

msgid ""
"Birds are attracted by an attraction point. Here you can choose to follow "
"Santa.\n"
"Flags: -followsanta 0, -followsanta 1"
msgstr ""
"Fuglar laðast að aðdráttarafl. Hér getur þú valið að fylgja Jólasveininum.\n"
"Flags: -followsanta 0, -followsanta 1"

msgid ""
"Percentage of screen to be used for the attraction point.\n"
"Flag: -attrspace"
msgstr ""
"Hlutfall af skjá sem á að nota fyrir aðdráttarpunkt.\n"
"Flag: -attrspace"

msgid "Attraction point range"
msgstr "Aðdráttarafl punktasvið"

msgid "Actual mean distance from neighbours."
msgstr "Raunveruleg meðalfjarlægð frá nágrönnum."

msgid "Distance used to get the desired number of neighbours."
msgstr "Fjarlægð notuð til að fá æskilegan fjölda nágranna."

msgid "Birds"
msgstr "Fuglar"

msgid "version"
msgstr "útgáfu"

msgid "Transparency "
msgstr "Gagnsæi "

msgid ""
"Transparency of painted items:\n"
"0: no transparency.\n"
"100: fully transparent, you will see nothing!\n"
"Flag: -transparency"
msgstr ""
"Gagnsæi málaðra hluta:\n"
"0: ekkert gagnsæi.\n"
"100: algjörlega gegnsætt, þú munt ekkert sjá!\n"
"Flag: -transparency"

msgid "Lift snow on bottom"
msgstr "Lyftu snjó á botninn"

msgid ""
"Use this if snow falls below the bottom of your screen, or  fallen snow "
"hides something that should not be hidden.\n"
"Flag: -offsets"
msgstr ""
"Notaðu þetta ef snjór fellur undir neðst á skjánum þínum, eða fallinn snjór "
"felur eitthvað sem ætti ekki að fela.\n"
"Flag: -offsets"

msgid "Lift snow on windows"
msgstr "Lyfta snjó á glugga"

msgid ""
"Use this if no snow collects on your windows, or if snow  collects separated "
"from your windows. \n"
"Some basic window managers need this setting (e.g. TWM  needs in general a "
"value of 25 .. 28).\n"
"Flag: -offsety"
msgstr ""
"Notaðu þetta ef enginn snjór safnast á gluggana þína, eða ef snjór safnast "
"aðskilinn frá gluggunum þínum. \n"
" Sumir grunn gluggastjórar þurfa þessa stillingu (t.d. þarf TWM almennt "
"gildið 25 .. 28).\n"
"Flag: -offsety"

msgid "Cpu factor"
msgstr "Örgjörva stuðull"

msgid ""
"The higher, the smoother xsnow will run, but will also use  more cpu power.\n"
"Flag: -cpuload"
msgstr ""
"Því hærra, því mýkri xsnow mun keyra, en mun einnig nota meira örgjörvaafl.\n"
"Flag: -cpuload"

msgid "Scale"
msgstr "Mælikvarði"

msgid ""
"Overall drawing scale.\n"
"Flag: -scale"
msgstr ""
"Heildar teiknikvarði.\n"
"Flag: -scale"

msgid "Ignore top windows"
msgstr "Hunsa efstu gluggana"

msgid ""
"Windows closer to the top  than the number in this widget will not collect "
"snow.\n"
"\n"
"In some cases, there are invisible windows near the top of the screen, which "
"are handled by xsnow as normal windows: snow is collected upon them. By "
"entering a suitable number here, this undesired behaviour can be avoided.\n"
"Flag: -ignoretop\n"
"\n"
msgstr ""
"Gluggar sem eru nær toppnum en talan í þessari græju munu ekki safna snjó.\n"
"\n"
"Í sumum tilfellum eru ósýnilegir gluggar nálægt toppi skjásins, sem eru "
"meðhöndlaðir af xsnow eins og venjulegir gluggar: snjór safnast á þá. Með "
"því að slá inn viðeigandi tölu hér er hægt að forðast þessa óæskilegu "
"hegðun.\n"
"Flag: -ignoretop\n"
"\n"

msgid "Ignore bottom windows"
msgstr "Hunsa neðstu gluggana"

msgid ""
"Windows closer to the  bottom than the number in this widget will not "
"collect snow.\n"
"\n"
"In some cases, there are invisible windows near the bottom  of  the screen, "
"which are handled by xsnow as normal windows: snow is collected upon them. "
"By entering a suitable  number here, this undesired behaviour can be "
"avoided.\n"
"Flag: -ignorebottom"
msgstr ""
"Gluggar sem eru nær botninum en númerið í þessari græju munu ekki safna "
"snjó.\n"
"\n"
"Í sumum tilfellum eru ósýnilegir gluggar nálægt neðst á skjánum, sem eru "
"meðhöndlaðir af xsnow eins og venjulegir gluggar: snjór safnast á þá. Með "
"því að slá inn viðeigandi tölu hér er hægt að forðast þessa óæskilegu "
"hegðun.\n"
"Flag: -ignorebottom"

msgid ""
"Menu\n"
"colors"
msgstr ""
"Valmynd\n"
" litir"

msgid ""
"Toggle between xsnow's own menu colors and standard menu colors.\n"
"Activated: use xsnow colors.\n"
"Deactivated: use default colors.\n"
"Flags: -theme 1, -theme 0"
msgstr ""
"Skiptu á milli eigin valmyndarlita xsnow og staðlaðra valmyndarlita.\n"
"Virkjaður: notaðu xsnow liti.\n"
"Slökkt: notaðu sjálfgefna liti.\n"
"Flags: -theme 1, -theme 0"

msgid ""
"On all\n"
"workspaces"
msgstr ""
"Á öllum \n"
" vinnusvæðum"

msgid ""
"Use all workspaces to snow in.\n"
"NOTE: this doesn't work properly in enlightenment.\n"
"Flags: -allworkspaces 1, -allworkspaces 0"
msgstr ""
"Notaðu öll vinnusvæði til að snjóa í.\n"
"ATHUGIÐ: þetta virkar ekki almennilega í uppljómun.\n"
"Flags: -allworkspaces 1, -allworkspaces 0"

msgid ""
"Below\n"
"windows"
msgstr ""
"Fyrir neðan \n"
" glugga"

msgid ""
"When activated, it will be snowing below your windows, else  it will be "
"snowing upon you windows too.\n"
"On some desktop environments, when snowing above your  windows you will not "
"be able to click on any window.\n"
"Therefore, you will be asked to click a button, to be sure that  things are "
"OK.\n"
"Flag: -above"
msgstr ""
"Þegar það er virkjað mun það snjóa fyrir neðan gluggana þína, annars snjóar "
"það líka yfir gluggana þína.\n"
"Í sumum skjáborðsumhverfi, þegar snjóar fyrir ofan gluggana þína muntu ekki "
"geta smellt á neinn glugga.\n"
"Þess vegna, þú verður beðinn um að smella á hnapp til að vera viss um að "
"allt sé í lagi.\n"
"Flag: -above"

msgid ""
"Click to\n"
"confirm"
msgstr ""
"Smelltu til að \n"
" staðfesta"

msgid "To make sure you can click."
msgstr "Til að tryggja að þú getir smellt."

msgid ""
"If you have more than one monitor, choose where you want snow falling. "
"Choose 'all monitors' if you want snow in all monitors.\n"
"NOTE: when changing monitor, xsnow will restart.\n"
"Flag: -screen"
msgstr ""
"Ef þú ert með fleiri en einn skjá skaltu velja hvar þú vilt snjóa. Veldu "
"'allir skjáir' ef þú vilt snjó í alla skjái.\n"
"ATHUGIÐ: þegar skipt er um skjá mun xsnow endurræsa.\n"
"Flag: -screen"

msgid "monitor 1"
msgstr "skjár 1"

msgid ""
"Create\n"
"outline"
msgstr ""
"Búðu til \n"
" yfirlit"

msgid ""
"To draw an outline around the snow window.\n"
"Flag: -outline 1/0"
msgstr ""
"Til að teikna útlínur í kringum snjógluggann.\n"
"Flag: -outline 1/0"

msgid ""
"Use \n"
"screenshots"
msgstr ""
"Notaðu \n"
" skjámyndir"

msgid "Use screenshots for the location of windows. Experimental."
msgstr "Notaðu skjámyndir fyrir staðsetningu glugga. Tilraunakennt."

msgid ""
"  \n"
"  "
msgstr ""
"  \n"
"  "

msgid ""
"Choose here the picture you want as background when  xscreensaver is "
"active.\n"
"Flag: -bg"
msgstr ""
"Veldu hér myndina sem þú vilt sem bakgrunn þegar xscreensaver er virkt.\n"
"Flag: -bg"

msgid "Choose background"
msgstr "Veldu bakgrunn"

msgid ""
"Activate xscreensaver.\n"
"Click and don't touch mouse and keyboard for a few seconds..."
msgstr ""
"Virkjaðu xscreensaver.\n"
"Smelltu og snertu ekki mús og lyklaborð í nokkrar sekúndur..."

msgid ""
"Settings for Xscreensaver. You can choose a background, and choose to use it "
"or not.\n"
"Make sure you add a line like\n"
"xsnow -root\n"
"after the line 'programs:' in the file ~/.xscreensaver and you run "
"xscreensaver-demo to choose for xsnow.\n"
"To activate xscreensaver on the command line:\n"
"xscreensaver-command  -activate\n"
"See also the man page:\n"
"man xsnow"
msgstr ""
"Stillingar fyrir Xscreensaver. Þú getur valið bakgrunn og valið að nota hann "
"eða ekki.\n"
"Gakktu úr skugga um að þú bætir línu eins og\n"
"xsnow -root\n"
"á eftir línunni 'programs:' í skránni ~/.xscreensaver og þú keyrir "
"xscreensaver-demo til að velja fyrir xsnow.\n"
"Til að virkja xscreensaver á skipanalínunni:\n"
"xscreensaver-command -activate\n"
"Sjá einnig mannasíðu:\n"
"man xsnow"

msgid "Xscreensaver: "
msgstr "Xscreensaver: "

msgid "Black"
msgstr "Svartur"

msgid ""
"When activated, the background will be black.\n"
"Flag: -bg  (this button will be automatically desactivated when -bg is given)"
msgstr ""
"Þegar það er virkjað verður bakgrunnurinn svartur.\n"
"Flag: -bg  (this button will be automatically desactivated when -bg is given)"

msgid ""
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
msgstr ""
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"
" \n"

msgid "en"
msgstr "en"

msgid "it"
msgstr "það"

#, c-format
msgid "The system is too busy, suggest to lower 'cpu load' in 'settings'\n"
msgstr ""
"Kerfið er of upptekið, legg til að lækka 'örgjörvaálag' í 'stillingar'\n"

#, c-format
msgid " or have a look at 'snow': 'Intensity', 'Max # of flakes', ...\n"
msgstr " eða kíktu á 'snjór': 'styrkur', 'hámarksfjöldi flögna', ... \n"

#, c-format
msgid " or specify a smaller number of birds in 'birds'\n"
msgstr " eða tilgreindu minni fjölda fugla í 'fuglar'\n"

