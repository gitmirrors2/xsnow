msgid "Warning: -auroraleft is deprecated, use -aurorax 25 instead.\n"
msgstr "Viðvörun: -auroraleft er úrelt, notaðu -aurorax 25 í staðinn.\n"

#, c-format
msgid "Warning: -auroramiddle is deprecated, use -aurorax 50 instead.\n"
msgstr "Viðvörun: -auroramiddle er úrelt, notaðu -aurorax 50 í staðinn.\n"

