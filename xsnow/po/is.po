msgstr "Stilltu sjálfgefnar stillingar fyrir þennan flipa."

msgid "<b>Vintage </b>"
msgstr "<b>árgangur </b>"

msgid "Set vintage preferences for this tab."
msgstr "Stilltu uppskerutímastillingar fyrir þennan flipa."

msgid "<b>All defaults </b>"
msgstr "<b>Allar sjálfgefnar stillingar </b>"

msgid "Set default preferences for all (except settings) tabs."
msgstr "Stilltu sjálfgefnar stillingar fyrir alla (nema stillingar) flipa."

msgid "<b>All vintage </b>"
msgstr "<b>Allur árgangur </b>"

msgid "Set vintage preferences for all (except settings) tabs."
msgstr "Stilltu uppskerutímastillingar fyrir alla (nema stillingar) flipa."

